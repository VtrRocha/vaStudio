// ==============================================================================
// VA STUDIO - EXEMPLO 01: CARD DE KPI EXECUTIVO MODERNO
// Objetivo: Exibir um KPI com valor principal, variação vs Meta/Ano Anterior,
//           barra de progresso e indicador visual de atingimento.
// ==============================================================================

Card KPI Executivo = 
VAR _ValorAtual = [Total Vendas]               // Substitua pela sua medida
VAR _Meta = [Meta Vendas]                       // Substitua pela sua meta
VAR _Atingimento = DIVIDE(_ValorAtual, _Meta, 0)
VAR _Variacao = _ValorAtual - _Meta
VAR _PctAting = ROUND(_Atingimento * 100, 1)

// Cores e Ícones
VAR _CorStatus = IF(_Atingimento >= 1, "#10b981", IF(_Atingimento >= 0.85, "#f59e0b", "#ef4444"))
VAR _Icone = IF(_Variacao >= 0, "▲", "▼")

// Formatação
VAR _FmtValor = FORMAT(_ValorAtual, "R$ #,##0")
VAR _FmtMeta = FORMAT(_Meta, "R$ #,##0")
VAR _FmtAting = FORMAT(_Atingimento, "0.0%")
VAR _LarguraBarra = MIN(100, MAX(0, _PctAting))

RETURN
"<style>
  * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', system-ui, sans-serif; }
  .card-kpi {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 16px 20px;
    box-shadow: 0 2px 6px rgba(0,0,0,0.04);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100vh;
  }
  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .card-title {
    font-size: 13px;
    font-weight: 600;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .badge {
    font-size: 11px;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 999px;
    background: " & _CorStatus & "15;
    color: " & _CorStatus & ";
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .card-value {
    font-size: 32px;
    font-weight: 800;
    color: #0f172a;
    line-height: 1.1;
    margin: 8px 0;
  }
  .progress-bg {
    width: 100%;
    height: 6px;
    background: #f1f5f9;
    border-radius: 999px;
    overflow: hidden;
    margin: 6px 0 10px 0;
  }
  .progress-fill {
    width: " & FORMAT(_LarguraBarra, "0") & "%;
    height: 100%;
    background: " & _CorStatus & ";
    border-radius: 999px;
    transition: width 0.3s ease;
  }
  .card-footer {
    display: flex;
    justify-content: space-between;
    font-size: 11.5px;
    color: #64748b;
  }
  .card-footer b { color: #334155; }
</style>

<div class='card-kpi'>
  <div class='card-header'>
    <span class='card-title'>Faturamento Realizado</span>
    <span class='badge'>" & _Icone & " " & _FmtAting & "</span>
  </div>
  
  <div class='card-value'>" & _FmtValor & "</div>
  
  <div class='progress-bg'>
    <div class='progress-fill'></div>
  </div>
  
  <div class='card-footer'>
    <span>Meta: <b>" & _FmtMeta & "</b></span>
    <span>Status: <b style='color:" & _CorStatus & "'>" & IF(_Atingimento >= 1, "Atingida", "Abaixo") & "</b></span>
  </div>
</div>"

