// ==============================================================================
// VA STUDIO - EXEMPLO 05: DASHBOARD EXECUTIVO INTERATIVO (LAYOUT BLACK / WHITE)
// Objetivo: Painel executivo completo em página única com cartão âncora (Hero KPI),
//           sparklines, série mensal, mapa de calor dia × hora, tabela com Curva ABC,
//           mix por categoria, tamanhos, botão de tema Black/White persistente
//           (`pbi.estado`) e assistente analítico com IA Gemini (`pbi.perguntarIA()`).
// ==============================================================================
// O QUE TROCAR PELOS NOMES DO SEU MODELO
//   [Faturamento], [Pedidos], [Pizzas Vendidas], [Dias com Venda], [Custo de Ingredientes]
//     -> medidas base do seu modelo semântico
//   dCalendario[Mês], dCalendario[Dia da Semana Nº]
//     -> colunas numéricas de mês (1..12) e dia da semana (1..7)
//   dPedido[Data], dPedido[Hora Cheia]
//     -> data do pedido e hora inteira (0..23)
//   dPizzaTipo[ID Sabor], dPizzaTipo[Sabor], dPizzaTipo[Categoria], dPizzaTipo[Ingredientes]
//     -> colunas da dimensão de produtos/sabores (note também pbi.filtrar([s.n], 'dPizzaTipo', 'Sabor'))
//   dPizza[Tamanho], dPizza[Preço]
//     -> dimensão de tamanhos/variantes
//   dIngrediente[...] e fEstoque[...]
//     -> usados na aba opcional "Estoque" (se não tiver tabela de estoque, troque por vazio)
//
// SEGURANÇA PARA GIT / PORTFÓLIO
//   - Nenhuma senha, IP de banco, servidor local ou chave de API vai nesta medida.
//   - Para ativar o botão de IA ("Pizz.IA"), cole sua chave da API do Gemini apenas
//     no Power BI em: Formatar > IA (Gemini) > Chave da API (ou use Endpoint Customizado).
// ==============================================================================

HTML Dashboard Pizzaria =
VAR _k =
    "{f:" & FORMAT( COALESCE( [Faturamento], 0 ) * 100, "0" )
        & ",p:" & FORMAT( COALESCE( [Pedidos], 0 ), "0" )
        & ",q:" & FORMAT( COALESCE( [Pizzas Vendidas], 0 ), "0" )
        & ",d:" & FORMAT( COALESCE( [Dias com Venda], 0 ), "0" )
        & ",de:'" & FORMAT( MIN( dPedido[Data] ), "yyyy-MM-dd" ) & "'"
        & ",ate:'" & FORMAT( MAX( dPedido[Data] ), "yyyy-MM-dd" ) & "'}"
VAR _m =
    CONCATENATEX(
        VALUES( dCalendario[Mês] ),
        VAR _eqM = CALCULATE( SUMX( fItemPedido, fItemPedido[Quantidade] * SWITCH( RELATED( dPizza[Tamanho] ), "S", 0.70, "M", 1.00, "L", 1.35, "XL", 1.70, "XXL", 2.10, 1.00 ) ) )
        VAR _cMes = COALESCE( [Custo de Ingredientes], 0 ) + COALESCE( _eqM, 0 ) * 6.1 + COALESCE( [Faturamento], 0 ) * 0.16
        RETURN
            "[" & dCalendario[Mês]
                & "," & FORMAT( COALESCE( [Faturamento], 0 ) * 100, "0" )
                & "," & FORMAT( COALESCE( [Pedidos], 0 ), "0" )
                & "," & FORMAT( COALESCE( [Dias com Venda], 0 ), "0" )
                & "," & FORMAT( COALESCE( [Pizzas Vendidas], 0 ), "0" )
                & "," & FORMAT( _cMes * 100, "0" )
                & "]",
        ",", dCalendario[Mês], ASC
    )
VAR _h =
    CONCATENATEX(
        FILTER(
            ADDCOLUMNS( CROSSJOIN( VALUES( dCalendario[Dia da Semana Nº] ), VALUES( dPedido[Hora Cheia] ) ), "@f", [Faturamento], "@p", [Pedidos] ),
            NOT ISBLANK( [@f] )
        ),
        "[" & dCalendario[Dia da Semana Nº] & "," & dPedido[Hora Cheia] & "," & FORMAT( [@f] * 100, "0" ) & "," & FORMAT( [@p], "0" ) & "]",
        ","
    )
VAR _c =
    CONCATENATEX(
        FILTER( ADDCOLUMNS( VALUES( dPizzaTipo[Categoria] ), "@f", [Faturamento], "@q", [Pizzas Vendidas] ), NOT ISBLANK( [@f] ) ),
        "['" & SUBSTITUTE( SUBSTITUTE( dPizzaTipo[Categoria], "\", "\\" ), "'", "\'" ) & "'," & FORMAT( [@f] * 100, "0" ) & "," & FORMAT( [@q], "0" ) & "]",
        ",", [@f], DESC
    )
VAR _z =
    CONCATENATEX(
        FILTER( ADDCOLUMNS( VALUES( dPizza[Tamanho] ), "@f", [Faturamento], "@q", [Pizzas Vendidas] ), NOT ISBLANK( [@f] ) ),
        "['" & dPizza[Tamanho] & "'," & FORMAT( [@f] * 100, "0" ) & "," & FORMAT( [@q], "0" ) & "]",
        ","
    )
VAR _sab = FILTER( ADDCOLUMNS( VALUES( dPizzaTipo[ID Sabor] ), "@f", [Faturamento] ), NOT ISBLANK( [@f] ) )
VAR _s =
    CONCATENATEX(
        _sab,
        "{id:'" & dPizzaTipo[ID Sabor]
            & "',n:'" & SUBSTITUTE( SUBSTITUTE( CALCULATE( MAX( dPizzaTipo[Sabor] ) ), "\", "\\" ), "'", "\'" )
            & "',c:'" & SUBSTITUTE( SUBSTITUTE( CALCULATE( MAX( dPizzaTipo[Categoria] ) ), "\", "\\" ), "'", "\'" )
            & "',i:'" & SUBSTITUTE( SUBSTITUTE( CALCULATE( MAX( dPizzaTipo[Ingredientes] ) ), "\", "\\" ), "'", "\'" )
            & "',f:" & FORMAT( [@f] * 100, "0" )
            & ",p:" & FORMAT( COALESCE( [Pedidos], 0 ), "0" )
            & ",q:" & FORMAT( COALESCE( [Pizzas Vendidas], 0 ), "0" )
            & ",d:" & FORMAT( COALESCE( [Dias com Venda], 0 ), "0" )
            & ",m:[" & CONCATENATEX(
                    VALUES( dCalendario[Mês] ),
                    "[" & dCalendario[Mês] & "," & FORMAT( COALESCE( [Faturamento], 0 ) * 100, "0" ) & "," & FORMAT( COALESCE( [Pedidos], 0 ), "0" ) & "," & FORMAT( COALESCE( [Dias com Venda], 0 ), "0" ) & "," & FORMAT( COALESCE( [Pizzas Vendidas], 0 ), "0" ) & "]",
                    ",", dCalendario[Mês], ASC )
            & "],h:[" & CONCATENATEX(
                    FILTER(
                        ADDCOLUMNS( CROSSJOIN( VALUES( dCalendario[Dia da Semana Nº] ), VALUES( dPedido[Hora Cheia] ) ), "@hf", [Faturamento], "@hp", [Pedidos] ),
                        NOT ISBLANK( [@hf] )
                    ),
                    "[" & dCalendario[Dia da Semana Nº] & "," & dPedido[Hora Cheia] & "," & FORMAT( [@hf] * 100, "0" ) & "," & FORMAT( [@hp], "0" ) & "]",
                    "," )
            & "],z:[" & CONCATENATEX(
                    FILTER( ADDCOLUMNS( VALUES( dPizza[Tamanho] ), "@zf", [Faturamento], "@zq", [Pizzas Vendidas] ), NOT ISBLANK( [@zf] ) ),
                    "['" & dPizza[Tamanho] & "'," & FORMAT( [@zf] * 100, "0" ) & "," & FORMAT( [@zq], "0" ) & "]",
                    "," )
            & "]}",
        ",", [@f], DESC
    )
VAR _ud = MAX( fEstoque[Data] )
VAR _gk = "{d:" & FORMAT( COALESCE( DISTINCTCOUNT( fEstoque[Data] ), 0 ), "0" ) & ",ate:'" & FORMAT( _ud, "yyyy-MM-dd" ) & "'}"
VAR _ing =
    CONCATENATEX(
        FILTER(
            ADDCOLUMNS( VALUES( dIngrediente[ID Ingrediente] ), "@fin", CALCULATE( SUM( fEstoque[Estoque Final] ), fEstoque[Data] = _ud ) ),
            NOT ISBLANK( [@fin] )
        ),
        VAR _mn = CALCULATE( MAX( dIngrediente[Estoque Mínimo (g)] ) )
        RETURN
            "{n:'" & SUBSTITUTE( SUBSTITUTE( CALCULATE( MAX( dIngrediente[Ingrediente] ) ), "\", "\\" ), "'", "\'" )
                & "',g:'" & SUBSTITUTE( SUBSTITUTE( CALCULATE( MAX( dIngrediente[Grupo] ) ), "\", "\\" ), "'", "\'" )
                & "',pm:" & FORMAT( COALESCE( CALCULATE( MAX( dIngrediente[Porção M (g)] ) ), 0 ) * 100, "0" )
                & ",cu:" & FORMAT( COALESCE( CALCULATE( MAX( dIngrediente[Custo por kg (US$)] ) ), 0 ) * 100, "0" )
                & ",mn:" & FORMAT( COALESCE( _mn, 0 ), "0" )
                & ",al:" & FORMAT( COALESCE( CALCULATE( MAX( dIngrediente[Estoque Alvo (g)] ) ), 0 ), "0" )
                & ",fin:" & FORMAT( [@fin], "0" )
                & ",co:" & FORMAT( COALESCE( CALCULATE( SUM( fEstoque[Consumo] ) ), 0 ), "0" )
                & ",en:" & FORMAT( COALESCE( CALCULATE( SUM( fEstoque[Entrada] ) ), 0 ), "0" )
                & ",ab:" & FORMAT( COALESCE( CALCULATE( COUNTROWS( fEstoque ), fEstoque[Estoque Final] < _mn ), 0 ), "0" )
                & ",m:[" & CONCATENATEX(
                        VALUES( dCalendario[Mês] ),
                        "[" & dCalendario[Mês]
                            & "," & FORMAT( COALESCE( CALCULATE( SUM( fEstoque[Consumo] ) ), 0 ), "0" )
                            & "," & FORMAT( COALESCE( CALCULATE( VAR _u = MAX( fEstoque[Data] ) RETURN CALCULATE( SUM( fEstoque[Estoque Final] ), fEstoque[Data] = _u ) ), 0 ), "0" ) & "]",
                        ",", dCalendario[Mês], ASC )
                & "]}",
        ","
    )
VAR _cad =
    CONCATENATEX(
        VALUES( dPizzaTipo[ID Sabor] ),
        "{id:'" & dPizzaTipo[ID Sabor]
            & "',n:'" & SUBSTITUTE( SUBSTITUTE( CALCULATE( MAX( dPizzaTipo[Sabor] ) ), "\", "\\" ), "'", "\'" )
            & "',c:'" & SUBSTITUTE( SUBSTITUTE( CALCULATE( MAX( dPizzaTipo[Categoria] ) ), "\", "\\" ), "'", "\'" )
            & "',i:'" & SUBSTITUTE( SUBSTITUTE( CALCULATE( MAX( dPizzaTipo[Ingredientes] ) ), "\", "\\" ), "'", "\'" )
            & "',pr:[" & CONCATENATEX( CALCULATETABLE( dPizza ), "['" & dPizza[Tamanho] & "'," & FORMAT( dPizza[Preço] * 100, "0" ) & "]", "," )
            & "]}",
        ","
    )
VAR _dados = "var D={k:" & _k & ",m:[" & _m & "],h:[" & _h & "],c:[" & _c & "],z:[" & _z & "],s:[" & _s & "],g:[" & _ing & "],gk:" & _gk & ",cad:[" & _cad & "]};"
VAR _css = "<style>
:root{--bg-canvas:#111217;--bg-surface:#181a20;--bg-elevated:#22252e;--bg-hover:#2c303c;--pri:#f97316;--pri-dk:#ea580c;--pri-s:rgba(249,115,22,0.18);--pri-bd:rgba(249,115,22,0.52);--pri-txt:#fdba74;--mint:#2bfdbe;--mint-bg:rgba(43,253,190,0.14);--mint-bd:rgba(43,253,190,0.32);--rose:#fb7185;--rose-bg:rgba(251,113,133,0.16);--rose-bd:rgba(251,113,133,0.32);--pearl:#ededed;--ink-pearl:#0a0a0a;--hero-lbl:#425d6b;--hero-sub:#4b5563;--hero-up:#059669;--hero-dn:#dc2626;--hero-vr-bg:rgba(10,10,10,0.06);--hero-vr-bd:rgba(10,10,10,0.12);--txt:#f4f4f6;--txt-soft:#e2e8f0;--sub:#a3b3bd;--muted:#8892a4;--bd:rgba(255,255,255,0.13);--bd-hi:rgba(255,255,255,0.26);--bd-row:rgba(255,255,255,0.06);--grid-ln:rgba(255,255,255,0.07);--bar-def:#4b5262;--bar-hov:#91a3ad;--bar-min:#343844;--cel-0:#22252e;--cel-bd:rgba(255,255,255,0.06);--cel-pico:#ffffff;--track:rgba(255,255,255,0.10);--abc-a:#0a0a0a;--ia-txt:#ffffff;--tip-bg:rgba(15,17,22,0.94);--tip-bd:rgba(255,255,255,0.26);--tip-b:#ffffff;--modal-bg:rgba(0,0,0,0.68);--scroll:rgba(255,255,255,0.22);--rad:6px;--font-d:'Montserrat','Inter','Segoe UI',system-ui,sans-serif;--font-b:'Roboto','Inter','Segoe UI',system-ui,sans-serif}
body.light{--bg-canvas:#f4f6fb;--bg-surface:#ffffff;--bg-elevated:#f8fafc;--bg-hover:#f1f5f9;--pri:#ea580c;--pri-dk:#c2410c;--pri-s:rgba(234,88,12,0.11);--pri-bd:rgba(234,88,12,0.38);--pri-txt:#9a3412;--mint:#059669;--mint-bg:#ecfdf5;--mint-bd:#a7f3d0;--rose:#dc2626;--rose-bg:#fef2f2;--rose-bd:#fecaca;--pearl:#111827;--ink-pearl:#f8fafc;--hero-lbl:#94a3b8;--hero-sub:#cbd5e1;--hero-up:#34d399;--hero-dn:#fb7185;--hero-vr-bg:rgba(255,255,255,0.10);--hero-vr-bd:rgba(255,255,255,0.18);--txt:#0f172a;--txt-soft:#334155;--sub:#475569;--muted:#64748b;--bd:rgba(15,23,42,0.11);--bd-hi:rgba(15,23,42,0.22);--bd-row:rgba(15,23,42,0.06);--grid-ln:rgba(15,23,42,0.06);--bar-def:#cbd5e1;--bar-hov:#fb923c;--bar-min:#94a3b8;--cel-0:#f1f5f9;--cel-bd:rgba(15,23,42,0.06);--cel-pico:#431407;--track:#e2e8f0;--abc-a:#ffffff;--ia-txt:#9a3412;--tip-bg:rgba(15,23,42,0.95);--tip-bd:rgba(15,23,42,0.25);--tip-b:#fb923c;--modal-bg:rgba(15,23,42,0.48);--scroll:rgba(15,23,42,0.2)}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:var(--font-b);background:var(--bg-canvas);color:var(--txt);overflow:hidden;-webkit-font-smoothing:antialiased;transition:background .18s,color .18s}
.num,td,.v,.lv,.vr,.cf,.est-bdg,.mgp{font-variant-numeric:tabular-nums}
#app{height:100vh;overflow:hidden;padding:10px 14px;display:grid;grid-template-rows:auto auto minmax(0,1fr) minmax(0,1.16fr);grid-template-columns:repeat(12,minmax(0,1fr));gap:10px;max-width:1680px;margin:0 auto}
.topo{grid-column:span 12;background:var(--bg-surface);border:1px solid var(--bd);border-radius:var(--rad);padding:9px 14px;display:flex;align-items:center;justify-content:space-between;gap:12px}
.top-l{display:flex;align-items:center;gap:12px;min-width:0}
.top-ico{width:34px;height:34px;border-radius:6px;background:var(--pri-s);border:1px solid var(--pri-bd);display:flex;align-items:center;justify-content:center;color:var(--pri);flex-shrink:0}
.eye{font-family:var(--font-d);font-size:9.5px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--sub);margin-bottom:2px}
.topo h1{font-family:var(--font-d);font-size:15.5px;font-weight:700;letter-spacing:-0.01em;color:var(--txt);white-space:nowrap}
.topo h1 span{color:var(--pri)}
.sub{font-size:11.5px;color:var(--sub);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.top-r{display:flex;align-items:center;gap:8px;flex-shrink:0}
.bt{background:var(--bg-elevated);color:var(--txt-soft);border:1px solid var(--bd);border-radius:4px;padding:5px 10px;font:600 11.5px var(--font-b);cursor:pointer;white-space:nowrap;display:inline-flex;align-items:center;gap:5px;transition:border-color .15s,background .15s,color .15s}
.bt:hover{border-color:var(--bd-hi);background:var(--bg-hover);color:var(--txt)}
.bt.tema{padding:5px 10px;font-weight:600}
.bt.ia{background:var(--pri-s);color:var(--ia-txt);border-color:var(--pri-bd);padding:6px 12px}
.bt.ia:hover{background:var(--pri-dk);border-color:var(--pri);color:#fff}
.bt.ia svg{color:var(--pri);transition:color .15s}
.bt.ia:hover svg{color:#fff}
.card{background:var(--bg-surface);border:1px solid var(--bd);border-radius:var(--rad);padding:11px 13px;display:flex;flex-direction:column;min-height:0;overflow:hidden;transition:border-color .15s,background .18s}
.card:hover{border-color:var(--bd-hi)}
.card h2{font-family:var(--font-d);font-size:12px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:var(--txt);display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:8px;flex-shrink:0}
.card h2 small,.card h2 span.hint{font-family:var(--font-b);font-size:11px;font-weight:400;text-transform:none;letter-spacing:0;color:var(--sub)}
.kpis{grid-column:span 12;display:grid;gap:10px;grid-template-columns:repeat(6,minmax(0,1fr))}
.kpi{border-top:2px solid var(--bd-hi);padding:10px 12px}
.kpi.hero{background:var(--pearl);color:var(--ink-pearl);border-color:var(--pearl);border-top:3px solid var(--pri)}
.kpi .t{font-family:var(--font-d);font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--sub)}
.kpi.hero .t{color:var(--hero-lbl)}
.kpi .v{font-family:var(--font-d);font-size:20px;font-weight:700;margin:3px 0 2px;letter-spacing:-0.02em;color:var(--txt)}
.kpi.hero .v{color:var(--ink-pearl)}
.kpi .s{font-size:11px;color:var(--sub);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.kpi.hero .s{color:var(--hero-sub)}
.kpi .r{display:flex;align-items:center;justify-content:space-between;gap:6px;margin-top:6px}
.sp{width:58px;height:20px;flex-shrink:0;display:block}
.vr{font-size:10.5px;font-weight:700;display:inline-flex;align-items:center;gap:2px;white-space:nowrap}
.vr.up{color:var(--mint)}.vr.dn{color:var(--rose)}
.kpi.hero .vr.up{color:var(--hero-up)}.kpi.hero .vr.dn{color:var(--hero-dn)}
.kpi .vr{background:var(--bg-elevated);padding:2px 6px;border-radius:4px;border:1px solid var(--bd)}
.kpi .vr.up{background:var(--mint-bg);border-color:var(--mint-bd)}
.kpi .vr.dn{background:var(--rose-bg);border-color:var(--rose-bd)}
.kpi.hero .vr{background:var(--hero-vr-bg);border-color:var(--hero-vr-bd)}
.mes,.cal{grid-column:span 6}.tab{grid-column:span 5}.cat{grid-column:span 4}.tam{grid-column:span 3}
.bars{flex:1;height:100%;display:flex;align-items:stretch;gap:4px;min-height:0;padding-top:2px;position:relative;background:repeating-linear-gradient(to top,var(--grid-ln) 0,var(--grid-ln) 1px,transparent 1px,transparent 33.33%)}
.b{flex:1;display:flex;flex-direction:column;align-items:center;min-width:0;cursor:pointer}
.b .lv{font-size:9px;font-weight:600;color:var(--txt-soft);white-space:nowrap;letter-spacing:-0.02em;line-height:1.15}
.b .vr{font-size:8.5px;line-height:1.1;margin-bottom:2px;height:11px;padding:0;background:none;border:none}
.b .cw{flex:1 1 auto;width:100%;display:flex;align-items:flex-end;min-height:36px}
.b .col{width:100%;background:var(--bar-def);border-radius:3px 3px 0 0;transition:height .35s,background .15s}
.b:hover .col{background:var(--bar-hov)}.b.max .col{background:var(--pri)}.b.min .col{background:var(--bar-min)}
.b .lx{font-size:10px;font-weight:600;color:var(--sub);margin-top:4px;white-space:nowrap}
.b.max .lx{color:var(--pri)}.b.min .lx{color:var(--muted)}
.b .ls{font-size:8.8px;color:var(--sub);white-space:nowrap;line-height:1.2}
.b .tg{font-size:8px;font-weight:700;height:11px;line-height:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.02em;white-space:nowrap}
.b.max .tg{color:var(--pri)}
.calg{flex:1;display:grid;gap:3px;min-height:0;align-content:stretch}
.hc{border-radius:3px;min-height:0}.hc.hd{font-size:10px;color:var(--sub);display:flex;align-items:flex-end;justify-content:center;padding-bottom:2px}
.hc.dl{font-size:10.5px;font-weight:600;color:var(--sub);display:flex;align-items:center}
.hc.cel{cursor:pointer;transition:transform .1s,border-color .1s;border:1px solid var(--cel-bd)}
.hc.cel:hover{transform:scale(1.1);z-index:2;border-color:var(--txt)}.hc.pico{outline:1.5px solid var(--cel-pico);outline-offset:-1px}
.calleg{display:flex;align-items:center;gap:6px;font-size:10.5px;color:var(--sub);margin-top:6px;flex-shrink:0}
.calleg i{width:64px;height:6px;border-radius:99px;background:linear-gradient(90deg,var(--cel-0),var(--pri));display:inline-block}
.seg{display:inline-flex;background:var(--bg-elevated);border:1px solid var(--bd);border-radius:4px;padding:2px;gap:2px}
.seg button{border:0;background:transparent;padding:3px 9px;border-radius:3px;font:600 11px var(--font-b);color:var(--sub);cursor:pointer;transition:all .15s}
.seg button.on{background:var(--pri);color:var(--abc-a)}
.tb{display:flex;gap:8px;align-items:center}
#busca{border:0;border-bottom:1.5px solid var(--muted);border-radius:0;background:transparent;padding:4px 2px;font:400 12px var(--font-b);width:140px;outline:none;color:var(--txt);text-transform:none;letter-spacing:0;transition:border-color .15s}
#busca::placeholder{color:var(--muted)}
#busca:focus{border-bottom-color:var(--pri)}
.tw{flex:1;overflow:auto;min-height:0;border:1px solid var(--bd);border-radius:4px;background:var(--bg-surface)}
table{width:100%;border-collapse:collapse;font-size:12px}
th{position:sticky;top:0;background:var(--bg-elevated);padding:7px 6px;text-align:right;font-family:var(--font-d);font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--sub);border-bottom:1px solid var(--bd);cursor:pointer;white-space:nowrap;user-select:none}
th:nth-child(1),th:nth-child(2),td:nth-child(1),td:nth-child(2){text-align:left}
th:last-child,td:last-child{padding-right:8px;text-align:center}
th:hover{color:var(--txt)}
td{padding:5.5px 6px;border-bottom:1px solid var(--bd-row);text-align:right;white-space:nowrap;color:var(--txt-soft)}
td:first-child{color:var(--muted);width:24px}
td:nth-child(2){white-space:normal;font-weight:600;color:var(--txt)}
td small{display:inline-block;margin-left:5px;font-size:9.5px;font-weight:600;color:var(--sub);background:var(--bg-elevated);border:1px solid var(--bd);padding:1px 5px;border-radius:3px}
tbody tr{cursor:pointer;transition:background .1s}
tbody tr:hover{background:var(--bg-hover)}
tbody tr.on{background:var(--pri-s)}
tbody tr.on td:nth-child(2){color:var(--pri)}
.barra{display:inline-block;height:4px;background:var(--pri);border-radius:99px;margin-left:5px;vertical-align:middle}
.abc{display:inline-flex;align-items:center;justify-content:center;width:19px;height:18px;border-radius:3px;font:700 10px var(--font-d)}
.abc.A{background:var(--pri);color:var(--abc-a)}.abc.B{background:var(--bg-elevated);color:var(--txt);border:1px solid var(--bd-hi)}.abc.C{background:transparent;color:var(--muted);border:1px solid var(--bd)}
.rod{font-size:10.5px;color:var(--sub);margin-top:6px;flex-shrink:0}
.mgp{display:inline-block;padding:1px 6px;border-radius:3px;font-size:10.5px;font-weight:700}
.mgp.hi{background:var(--mint-bg);color:var(--mint)}.mgp.md{background:var(--pri-s);color:var(--pri-txt)}.mgp.lo{background:var(--rose-bg);color:var(--rose)}
#cat{flex:1;display:flex;flex-direction:column;gap:4px;min-height:0;overflow:auto;padding-right:2px}
.citem{border:1px solid var(--bd);border-radius:4px;padding:4.5px 9px;cursor:pointer;background:var(--bg-elevated);transition:border-color .15s,background .15s}
.citem:hover{border-color:var(--bd-hi);background:var(--bg-hover)}
.citem.on{border-color:var(--pri);background:var(--pri-s)}
.ctop{display:flex;justify-content:space-between;align-items:center;font-size:11.5px}
.ctop .cn{font-weight:700;color:var(--txt)}.ctop .cf{font-weight:700;color:var(--txt)}
.cmid{display:flex;justify-content:space-between;align-items:center;font-size:10px;color:var(--sub);margin:1.5px 0 3.5px}
.tr{height:4px;background:var(--track);border-radius:99px;overflow:hidden}
.fi{height:100%;background:var(--pri);border-radius:99px}
.bdg-al{display:inline-block;min-width:16px;padding:0 4px;height:15px;line-height:15px;border-radius:3px;background:var(--rose);color:#fff;font-size:10px;font-weight:700;text-align:center;margin-left:4px}
.est-row{border:1px solid var(--bd);border-radius:4px;padding:6px 9px;background:var(--bg-elevated);cursor:pointer;transition:border-color .15s}
.est-row:hover{border-color:var(--bd-hi)}
.est-top{display:flex;justify-content:space-between;align-items:center;font-size:11.5px;margin-bottom:2px}
.est-top b{color:var(--txt)}
.est-meta{display:flex;justify-content:space-between;font-size:10.5px;color:var(--sub);margin-bottom:4px}
.est-tr{height:4px;background:var(--track);border-radius:99px;overflow:hidden}
.est-fi{height:100%;border-radius:99px}
.est-bdg{padding:1px 6px;border-radius:3px;font-size:10px;font-weight:700}
.est-bdg.crit{background:var(--rose-bg);color:var(--rose)}.est-bdg.att{background:var(--pri-s);color:var(--pri-txt)}.est-bdg.ok{background:var(--mint-bg);color:var(--mint)}
.tam .bars{flex:1}
.al{background:var(--bg-elevated);border:1px solid var(--bd);border-left:3px solid var(--pri);border-radius:4px;padding:7px 9px;font-size:11px;line-height:1.4;color:var(--txt-soft);margin-top:8px;flex-shrink:0}
#tip{position:fixed;pointer-events:none;background:var(--tip-bg);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border:1px solid var(--tip-bd);color:#efeff1;padding:8px 11px;border-radius:var(--rad);font-size:11.5px;line-height:1.5;max-width:290px;opacity:0;transition:opacity .12s;z-index:20;box-shadow:0 8px 24px rgba(0,0,0,0.45)}
#tip b{color:var(--tip-b)}
#modal{position:fixed;inset:0;background:var(--modal-bg);backdrop-filter:blur(4px);display:none;align-items:center;justify-content:center;padding:16px;z-index:30}
#modal .box{background:var(--bg-surface);border:1px solid var(--bd-hi);border-radius:var(--rad);max-width:600px;width:100%;padding:16px;display:flex;flex-direction:column;gap:8px;max-height:85vh;color:var(--txt)}
#modal h2{font-family:var(--font-d);font-size:14px;display:flex;justify-content:space-between;align-items:center}
#modal textarea{width:100%;height:210px;border:1px solid var(--bd);background:var(--bg-canvas);color:var(--txt);border-radius:4px;padding:8px;font:11.5px/1.4 monospace;resize:vertical}
#modal .acoes{display:flex;gap:8px;align-items:center}
#modal .msg{font-size:12px;color:var(--mint)}
#iaP{position:fixed;top:12px;right:12px;bottom:12px;width:430px;max-width:calc(100vw - 24px);background:var(--bg-surface);border:1px solid var(--bd-hi);border-radius:var(--rad);box-shadow:-12px 12px 36px rgba(0,0,0,0.35);display:flex;flex-direction:column;z-index:40;transform:translateX(calc(100% + 28px));transition:transform .2s;overflow:hidden}
#iaP.on{transform:translateX(0)}
.iah{padding:11px 14px;background:var(--bg-elevated);border-bottom:1px solid var(--bd);color:var(--txt);display:flex;align-items:center;gap:8px}
.iah b{font-family:var(--font-d);font-size:13.5px;flex:1;display:flex;align-items:center;gap:7px}
.iah b svg{color:var(--pri)}
.iah button{background:transparent;color:var(--sub);border:1px solid var(--bd);border-radius:4px;padding:4px 8px;font:600 11px var(--font-b);cursor:pointer}
.iah button:hover{border-color:var(--bd-hi);color:var(--txt)}
.iab{flex:1;overflow:auto;padding:12px;display:flex;flex-direction:column;gap:10px}
.iaesc{font-size:11px;color:var(--sub);background:var(--bg-elevated);border:1px solid var(--bd);border-radius:4px;padding:5px 9px;align-self:flex-start}
.iaop{text-align:left;background:var(--bg-elevated);border:1px solid var(--bd);border-radius:var(--rad);padding:12px 13px;cursor:pointer;transition:all .15s;color:var(--txt)}
.iaop:hover{border-color:var(--pri);background:var(--bg-hover)}
.iaop .t{font-family:var(--font-d);font-size:13px;font-weight:700;margin-bottom:4px;color:var(--txt)}.iaop .d{font-size:12px;color:var(--sub);line-height:1.45}
.iaintro{font-size:12px;color:var(--sub);line-height:1.5}
.iasug{display:flex;flex-direction:column;gap:6px}
.iasug button{text-align:left;background:var(--bg-elevated);border:1px solid var(--bd);border-radius:4px;padding:7px 10px;font:500 11.5px var(--font-b);color:var(--txt-soft);cursor:pointer}
.iasug button:hover{border-color:var(--pri);color:var(--txt)}
.iamsg{padding:9px 11px;border-radius:var(--rad);font-size:12.5px;line-height:1.5;max-width:92%;word-wrap:break-word}
.iamsg.u{align-self:flex-end;background:var(--pri);color:var(--abc-a);font-weight:600}
.iamsg.a{align-self:flex-start;background:var(--bg-elevated);border:1px solid var(--bd);color:var(--txt)}
.iamsg.e{align-self:flex-start;background:var(--rose-bg);border:1px solid var(--rose-bd);color:var(--rose)}
.iamd{font-size:12.5px;line-height:1.55;color:var(--txt)}.iamd h3{font-family:var(--font-d);font-size:12px;text-transform:uppercase;letter-spacing:.04em;color:var(--pri);margin:10px 0 4px}.iamd h3:first-child{margin-top:0}.iamd ul{padding-left:17px;margin:4px 0}.iamd li{margin:2px 0}.iamd p{margin:4px 0}
.iabt{align-self:flex-start;background:var(--bg-elevated);border:1px solid var(--bd);border-radius:4px;padding:6px 10px;font:600 11.5px var(--font-b);color:var(--txt);cursor:pointer}.iabt:hover{border-color:var(--pri);color:var(--pri)}
.iaf{padding:10px 12px;border-top:1px solid var(--bd);background:var(--bg-elevated);display:flex;gap:8px;align-items:flex-end}
.iaf textarea{flex:1;border:1px solid var(--bd);background:var(--bg-canvas);color:var(--txt);border-radius:4px;padding:7px 9px;font:12.5px/1.35 var(--font-b);resize:none;height:36px;max-height:96px;outline:none}
.iaf textarea:focus{border-color:var(--pri)}
.iaf button{background:var(--pri);color:var(--abc-a);border:0;border-radius:4px;padding:0 14px;height:36px;font:700 12px var(--font-d);cursor:pointer}
.iaf button:disabled{opacity:.45;cursor:default}
.iadig{display:inline-flex;gap:4px;vertical-align:middle;margin-right:6px}.iadig i{width:6px;height:6px;border-radius:50%;background:var(--pri);animation:p 1.2s infinite}.iadig i:nth-child(2){animation-delay:.2s}.iadig i:nth-child(3){animation-delay:.4s}
@keyframes p{0%,80%,100%{opacity:.25}40%{opacity:1}}
::-webkit-scrollbar{width:6px;height:6px}::-webkit-scrollbar-thumb{background:var(--scroll);border-radius:99px}
@media (max-width:1000px){body{overflow:auto}#app{height:auto;overflow:visible;grid-template-rows:auto}.kpis{grid-template-columns:repeat(3,minmax(0,1fr))}.mes,.cal,.tab,.cat,.tam{grid-column:span 12}.bars{min-height:175px}.calg{min-height:190px}.tw{max-height:310px}}
</style>"
VAR _html = "<div id='app' data-tema='dark'>
<header class='topo'>
  <div class='top-l'>
    <div class='top-ico'><svg viewBox='0 0 24 24' width='18' height='18' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M12 2L2 19a15 15 0 0 0 20 0Z'/><path d='M4 15.6a12 12 0 0 0 16 0'/><circle cx='12' cy='9.5' r='1' fill='currentColor'/><circle cx='9.5' cy='13.5' r='1' fill='currentColor'/><circle cx='14.5' cy='13' r='1' fill='currentColor'/></svg></div>
    <div style='min-width:0'>
      <div class='eye'>Painel Executivo · Pizzaria Artesanal</div>
      <h1>Pizzaria · <span>Painel de Vendas</span></h1>
      <div class='sub' id='sub'></div>
    </div>
  </div>
  <div class='top-r'>
    <button id='btLimpar' class='bt' style='display:none'></button>
    <button id='btTema' class='bt tema' title='Alternar layout Black / White'></button>
    <button id='btIA' class='bt ia' style='display:none'><svg viewBox='0 0 24 24' width='15' height='15' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M12 2L2 19a15 15 0 0 0 20 0Z'/><path d='M4 15.6a12 12 0 0 0 16 0'/><circle cx='12' cy='9.5' r='1' fill='currentColor'/><circle cx='9.5' cy='13.5' r='1' fill='currentColor'/><circle cx='14.5' cy='13' r='1' fill='currentColor'/></svg><span>Pizz.IA</span></button>
  </div>
</header>
<div class='kpis' id='kpis'></div>
<div class='card mes'><h2>Faturamento por mês <span class='hint' id='mesSub'></span></h2><div class='bars' id='mes'></div></div>
<div class='card cal'><h2>Quando a pizzaria vende <span class='hint' id='calSub'></span></h2><div class='calg' id='calor'></div><div class='calleg' id='calLeg'></div></div>
<div class='card tab'><h2>Sabores · Curva ABC <span class='tb'><span class='seg' id='segOrd'></span><input id='busca' placeholder='Buscar sabor...'><button id='btX' class='bt'>⬇ Excel</button></span></h2><div class='tw'><table><thead id='th'></thead><tbody id='tb'></tbody></table></div><div class='rod' id='rod'></div></div>
<div class='card cat'><h2><span id='catTit'>Categorias · Mix &amp; Margem</span> <span class='seg' id='segCat'></span></h2><div id='cat'></div></div>
<div class='card tam'><h2>Tamanhos <span class='hint' id='tamSub'></span></h2><div class='bars' id='tam'></div><div class='al' id='tamAl' style='display:none'></div></div>
</div><div id='tip'></div><div id='modal'></div><div id='iaP'></div>"
VAR _js = "var api = window.pbi || { estado: {}, filtrar: function () {}, limpar: function () {}, iaConfigurada: function () { return false; } };
var st = api.estado;
st.met = 'f';
if (!st.tema) st.tema = 'dark';
if (!st.ia) st.ia = { modo: null, chat: [], analise: null, esperando: false, rascunho: '' };
if (!st.ord) st.ord = { c: 'f', d: -1 };
if (!st.catView) st.catView = 'cat';
if (st.catFil === undefined) st.catFil = null;
if (st.busca === undefined) st.busca = '';
var MES = ['jan', 'fev', 'mar', 'abr', 'mai', 'jun', 'jul', 'ago', 'set', 'out', 'nov', 'dez'];
var MESN = ['Janeiro', 'Fevereiro', 'Março', 'Abril', 'Maio', 'Junho', 'Julho', 'Agosto', 'Setembro', 'Outubro', 'Novembro', 'Dezembro'];
var DIA = ['Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sáb', 'Dom'];
var DIAN = ['Segunda', 'Terça', 'Quarta', 'Quinta', 'Sexta', 'Sábado', 'Domingo'];
var TAM = ['S', 'M', 'L', 'XL', 'XXL'];
var TAMN = { S: 'Pequena', M: 'Média', L: 'Grande', XL: 'Extragrande', XXL: 'Gigante' };
var FAT = { S: 0.7, M: 1, L: 1.35, XL: 1.7, XXL: 2.1 };
var TAML = { S: 'P', M: 'M', L: 'G', XL: 'GG', XXL: 'XGG' };
var CATN = { Classic: 'Clássica', Supreme: 'Suprema', Chicken: 'Frango', Veggie: 'Vegetariana' };
var BASE_M = 290; // massa artesanal + molho base + embalagem/caixa (US$ 2,90 por pizza M equivalente)
var OP_M = 320;   // mão de obra cozinha/forno/atendimento + energia/aluguel rateado (US$ 3,20 por pizza M equivalente)
var TAXA_V = 0.16; // impostos + taxas cartão/delivery (16% do faturamento)
var NOMES = { bbq_ckn: 'Frango ao Barbecue', big_meat: 'Super Carnes', brie_carre: 'Brie Carré', calabrese: 'Calabresa Italiana', cali_ckn: 'Frango Califórnia',
  ckn_alfredo: 'Frango Alfredo', ckn_pesto: 'Frango ao Pesto', classic_dlx: 'Clássica Deluxe', five_cheese: 'Cinco Queijos', four_cheese: 'Quatro Queijos',
  green_garden: 'Horta Verde', hawaiian: 'Havaiana', ital_cpcllo: 'Italiana com Capocollo', ital_supr: 'Italiana Suprema', ital_veggie: 'Vegetais Italianos',
  mediterraneo: 'Mediterrânea', mexicana: 'Mexicana', napolitana: 'Napolitana', pep_msh_pep: 'Pepperoni, Cogumelos e Pimentões', pepperoni: 'Pepperoni',
  peppr_salami: 'Salame Apimentado', prsc_argla: 'Presunto Cru e Rúcula', sicilian: 'Siciliana', soppressata: 'Soppressata', southw_ckn: 'Frango do Sudoeste',
  spicy_ital: 'Italiana Picante', spin_pesto: 'Espinafre ao Pesto', spinach_fet: 'Espinafre e Feta', spinach_supr: 'Espinafre Suprema', thai_ckn: 'Frango Tailandês',
  the_greek: 'Grega', veggie_veg: 'Vegetais em Dobro' };
var INGPT = { 'garlic': 'Alho', 'tomatoes': 'Tomate', 'red onions': 'Cebola roxa', 'red peppers': 'Pimentão vermelho', 'mozzarella cheese': 'Muçarela', 'pepperoni': 'Pepperoni',
  'spinach': 'Espinafre', 'mushrooms': 'Cogumelos', 'chicken': 'Frango', 'capocollo': 'Capocollo', 'green olives': 'Azeitona verde', 'jalapeno peppers': 'Pimenta jalapeño',
  'artichokes': 'Alcachofra', 'artichoke': 'Alcachofra', 'green peppers': 'Pimentão verde', 'feta cheese': 'Queijo feta', 'pineapple': 'Abacaxi', 'bacon': 'Bacon',
  'chipotle sauce': 'Molho chipotle', 'corn': 'Milho', 'cilantro': 'Coentro', 'asiago cheese': 'Queijo asiago', 'goat cheese': 'Queijo de cabra', 'fontina cheese': 'Queijo fontina',
  'kalamata olives': 'Azeitona kalamata', 'pesto sauce': 'Molho pesto', 'zucchini': 'Abobrinha', 'barbecued chicken': 'Frango ao barbecue', 'barbecue sauce': 'Molho barbecue',
  'sliced ham': 'Presunto fatiado', 'thai sweet chilli sauce': 'Molho tailandês agridoce', 'gouda cheese': 'Queijo gouda', 'luganega sausage': 'Linguiça luganega',
  'coarse sicilian salami': 'Salame siciliano', 'onions': 'Cebola', 'peperoncini verdi': 'Peperoncini verde', 'chorizo sausage': 'Linguiça chorizo', 'italian sausage': 'Linguiça italiana',
  'sun-dried tomatoes': 'Tomate seco', 'parmigiano reggiano cheese': 'Parmigiano reggiano', 'gorgonzola piccante cheese': 'Gorgonzola picante', 'ricotta cheese': 'Ricota',
  'calabrese salami': 'Salame calabrês', 'anchovies': 'Anchovas', 'arugula': 'Rúcula', 'prosciutto di san daniele': 'Prosciutto di San Daniele', 'genoa salami': 'Salame genovês',
  'oregano': 'Orégano', 'beef chuck roast': 'Carne bovina assada', 'romano cheese': 'Queijo romano', 'provolone cheese': 'Provolone', 'smoked gouda cheese': 'Gouda defumado',
  'blue cheese': 'Queijo azul', 'alfredo sauce': 'Molho alfredo', 'eggplant': 'Berinjela', 'soppressata salami': 'Salame soppressata', 'friggitello peppers': 'Pimenta friggitello',
  'pancetta': 'Pancetta', '‘nduja salami': 'Salame nduja', 'plum tomatoes': 'Tomate italiano', 'pears': 'Pera', 'brie carre cheese': 'Queijo brie carré',
  'caramelized onions': 'Cebola caramelizada', 'thyme': 'Tomilho', 'prosciutto': 'Prosciutto' };
function catPt(c) { return CATN[c] || c; }
function nomeS(s) { return NOMES[s.id] || curto(s.n).replace(/^Pizza de /i, ''); }
function ingPt(x) { x = String(x).trim(); return INGPT[x.toLowerCase()] || x; }
function ingsPt(txt) { return receita(txt).map(ingPt).join(', '); }

// Custo realista de produção e operação, curva ABC e resumo por categoria
function prep() {
  var G = {};
  (D.g || []).forEach(function (g) { G[chaveIng(g.n)] = g; });
  D.catMeta = {};
  D.s.forEach(function (s) {
    var vis = {}, cm = 0, eq = 0;
    receita(s.i).forEach(function (x) { var k = chaveIng(x), g = G[k]; if (g && !vis[k]) { vis[k] = 1; cm += g.pm / 100000 * (g.cu || 0); } });
    s.z.forEach(function (r) { eq += r[2] * (FAT[r[0]] || 1); });
    s.np = nomeS(s);
    s.cm = cm;
    s.ci = cm * eq;
    s.cprod = s.ci + eq * BASE_M;
    s.op = eq * OP_M + s.f * TAXA_V;
    s.cu = s.cprod + s.op;
    s.mg = s.f ? (s.f - s.cu) / s.f : 0;
    var cm1 = D.catMeta[s.c] || (D.catMeta[s.c] = { f: 0, q: 0, ci: 0, cprod: 0, cu: 0 });
    cm1.f += s.f; cm1.q += s.q; cm1.ci += s.ci; cm1.cprod += s.cprod; cm1.cu += s.cu;
  });
  Object.keys(D.catMeta).forEach(function (k) {
    var o = D.catMeta[k]; o.mg = o.f ? (o.f - o.cu) / o.f : 0;
  });
  var tot = D.s.reduce(function (a, s) { return a + s.f; }, 0) || 1, ac = 0;
  D.s.slice().sort(function (a, b) { return b.f - a.f; }).forEach(function (s, idx) {
    ac += s.f; s.ac = ac / tot; s.abc = (idx === 0 || s.ac <= 0.8) ? 'A' : s.ac <= 0.95 ? 'B' : 'C';
  });
  D.custo = D.s.reduce(function (a, s) { return a + s.cu; }, 0);
  D.cprod = D.s.reduce(function (a, s) { return a + s.cprod; }, 0);
  D.ci = D.s.reduce(function (a, s) { return a + s.ci; }, 0);
  D.cmes = {};
  D.m.forEach(function (r) { if (r[5] != null) D.cmes[r[0]] = r[5]; });
}

var ULT = [];
var nf = new Intl.NumberFormat('pt-BR');
var cur = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'USD' });

function el(id) { return document.getElementById(id); }
function usd(c) { return cur.format((c || 0) / 100); }
function usdk(c) { var v = (c || 0) / 100; if (Math.abs(v) >= 1e6) return n1(v / 1e6) + ' mi'; if (Math.abs(v) >= 1e3) return n1(v / 1e3) + ' mil'; return n(v); }
function usdc(c) {
  var v = (c || 0) / 100;
  if (Math.abs(v) >= 1e6) return 'US$ ' + (v / 1e6).toLocaleString('pt-BR', { maximumFractionDigits: 2 }) + ' mi';
  if (Math.abs(v) >= 1e3) return 'US$ ' + (v / 1e3).toLocaleString('pt-BR', { maximumFractionDigits: 1, minimumFractionDigits: 1 }) + ' mil';
  return usd(c);
}
function n(x) { return nf.format(Math.round(x || 0)); }
function n1(x) { return (x || 0).toLocaleString('pt-BR', { maximumFractionDigits: 1, minimumFractionDigits: 1 }); }
function pct(x) { return ((x || 0) * 100).toLocaleString('pt-BR', { maximumFractionDigits: 1, minimumFractionDigits: 1 }) + '%'; }
function esc(t) { return String(t == null ? '' : t).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/'/g, '&#39;'); }
function curto(nome) { return String(nome).replace(/^The /, '').replace(/ Pizza$/, ''); }
function dt(s) { var p = s.split('-'); return p[2] + '/' + p[1] + '/' + p[0]; }

var tip = el('tip');
function mostrar(e, html) {
  tip.innerHTML = html; tip.style.opacity = 1;
  var x = e.clientX + 14, y = e.clientY + 14, w = tip.offsetWidth, h = tip.offsetHeight;
  if (x + w > window.innerWidth - 8) x = e.clientX - w - 14;
  if (y + h > window.innerHeight - 8) y = e.clientY - h - 14;
  tip.style.left = Math.max(4, x) + 'px'; tip.style.top = Math.max(4, y) + 'px';
}
function esconder() { tip.style.opacity = 0; }
function dica(no, fn) { no.onmousemove = function (e) { mostrar(e, fn()); }; no.onmouseleave = esconder; }

function item() {
  if (!st.sel) return null;
  for (var i = 0; i < D.s.length; i++) if (D.s[i].id === st.sel) return D.s[i];
  return null;
}
function escopo() {
  var s = item();
  if (s) return { k: { f: s.f, p: s.p, q: s.q, d: s.d }, m: s.m, h: s.h, z: s.z, s: s, nome: nomeS(s) };
  return { k: D.k, m: D.m, h: D.h, z: D.z, s: null, nome: null };
}
function rotulo(E) { return E.s ? 'só ' + E.nome : 'todos os sabores'; }

function escolher(id) {
  if (st.sel === id) { st.sel = null; api.limpar(); }
  else { st.sel = id; var s = item(); api.filtrar([s.n], 'dPizzaTipo', 'Sabor'); }
  tudo();
}

var SOL_ICO = `<svg viewBox='0 0 24 24' width='13' height='13' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='4'/><path d='M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41'/></svg>`;
var LUA_ICO = `<svg viewBox='0 0 24 24' width='13' height='13' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z'/></svg>`;
function aplicarTema() {
  var lt = st.tema === 'light';
  if (document.body) document.body.classList.toggle('light', lt);
  var ap = el('app'); if (ap) ap.setAttribute('data-tema', st.tema);
  var bt = el('btTema');
  if (bt) {
    bt.innerHTML = (lt ? LUA_ICO : SOL_ICO) + '<span>' + (lt ? 'Black' : 'White') + '</span>';
    bt.title = lt ? 'Mudar para layout Black' : 'Mudar para layout White';
    bt.onclick = function () { st.tema = st.tema === 'light' ? 'dark' : 'light'; aplicarTema(); tudo(); };
  }
}
function topo(E) {
  el('sub').textContent = dt(D.k.de) + ' a ' + dt(D.k.ate) + ' · ' + n(D.s.length) + ' sabores · mostrando ' + rotulo(E);
  var bl = el('btLimpar');
  if (E.s) { bl.style.display = ''; bl.textContent = '✕ ' + E.nome; bl.title = 'Limpar a seleção'; bl.onclick = function () { escolher(st.sel); }; }
  else if (st.catFil) { bl.style.display = ''; bl.textContent = '✕ Categoria: ' + catPt(st.catFil); bl.title = 'Limpar filtro de categoria'; bl.onclick = function () { st.catFil = null; tudo(); }; }
  else bl.style.display = 'none';
  var bi = el('btIA');
  bi.style.display = api.iaConfigurada && api.iaConfigurada() ? '' : 'none';
  bi.onclick = iaAbrir;
  aplicarTema();
}

function spark(vals, darkTxt) {
  var v = vals.filter(function (x) { return x != null && isFinite(x); });
  if (v.length < 2) return '';
  var mn = Math.min.apply(null, v), mx = Math.max.apply(null, v), W = 64, H = 22, a = mx - mn || 1;
  var pts = v.map(function (x, i) { return (2 + i * (W - 5) / (v.length - 1)).toFixed(1) + ',' + (H - 3 - (x - mn) / a * (H - 6)).toFixed(1); });
  var u = pts[pts.length - 1].split(',');
  return `<svg class='sp' viewBox='0 0 ${W} ${H}' width='${W}' height='${H}'><polyline points='${pts.join(' ')}' fill='none' stroke='${(st.tema === `light`) ? (darkTxt ? `#94a3b8` : `#64748b`) : (darkTxt ? `#425d6b` : `#91a3ad`)}' stroke-width='1.6' stroke-linejoin='round' stroke-linecap='round'/><circle cx='${u[0]}' cy='${u[1]}' r='2.5' fill='${(st.tema === `light`) ? (darkTxt ? `#f97316` : `#0f172a`) : (darkTxt ? `#0a0a0a` : `#f97316`)}'/></svg>`;
}
function selo(v, txt, pp) {
  if (v == null || !isFinite(v)) return '';
  var val = pp ? n1(Math.abs(v) * 100) + ' pontos' : pct(Math.abs(v));
  return `<span class='vr ${v >= 0 ? 'up' : 'dn'}'>${v >= 0 ? '▲ +' : '▼ −'}${val}${txt ? ' ' + txt : ''}</span>`;
}
function tri(m, fn, fd) {
  if (m.length < 6) return null;
  function rz(l) { var a = 0, b = 0; l.forEach(function (r) { a += fn(r); b += fd(r); }); return b ? a / b : null; }
  var x = rz(m.slice(0, 3)), y = rz(m.slice(-3));
  return x && y != null ? { a: x, b: y, v: y / x - 1 } : null;
}

function kpis(E) {
  var k = E.k, m = E.m, tk = k.p ? k.f / k.p : 0, pp = k.p ? k.q / k.p : 0;
  var TR = m.length === 12 ? 'T4 vs T1' : 'fim vs início';
  var custo = E.s ? E.s.cu : D.custo, cprod = E.s ? E.s.cprod : D.cprod, ci = E.s ? E.s.ci : D.ci;
  var temC = custo > 0, mg = k.f ? (k.f - custo) / k.f : 0;
  function F(r) { return r[1]; } function P(r) { return r[2]; } function Dd(r) { return r[3]; } function Q(r) { return r[4]; }
  function Cm(r) { return D.cmes[r[0]] || 0; }
  function serie(fn, fd) { return m.map(function (r) { return fd(r) ? fn(r) / fd(r) : null; }); }
  var tm = !E.s && temC ? tri(m, function (r) { return F(r) - Cm(r); }, F) : null;
  var c = [
    ['Faturamento', usdc(k.f), E.s ? pct(k.f / D.k.f) + ' do faturamento total' : 'média de ' + usdc(k.d ? k.f / k.d : 0) + ' por dia', serie(F, Dd), tri(m, F, Dd), 'média por dia de operação'],
    ['Pedidos', n(k.p), n1(k.d ? k.p / k.d : 0) + ' por dia em ' + n(k.d) + ' dias', serie(P, Dd), tri(m, P, Dd), 'pedidos por dia de operação'],
    ['Pizzas vendidas', n(k.q), 'preço médio de ' + usd(k.q ? k.f / k.q : 0), serie(Q, Dd), tri(m, Q, Dd), 'pizzas por dia de operação'],
    ['Ticket médio', usd(tk), E.s ? 'pedidos com este sabor' : 'faturamento ÷ pedidos', serie(F, P), tri(m, F, P), 'ticket médio'],
    ['Pizzas por pedido', n1(pp), E.s ? 'pizzas deste sabor por pedido' : 'média de pizzas no pedido', serie(Q, P), tri(m, Q, P), 'pizzas por pedido'],
    ['Margem líquida', temC ? pct(mg) : '–', temC ? 'custo total ' + usdc(custo) + ' (' + pct(custo / k.f) + ')' : 'sem dados de custo', !E.s && temC ? m.map(function (r) { return F(r) ? 1 - Cm(r) / F(r) : null; }) : [], tm ? { v: tm.b - tm.a, pp: true } : null, 'margem líquida mensal']
  ];
  el('kpis').innerHTML = c.map(function (x, i) {
    return `<div class='card kpi${i === 0 ? ` hero` : ``}'><div class='t'>${x[0]}</div><div class='v'>${esc(x[1])}</div><div class='s'>${esc(x[2])}</div><div class='r'>${spark(x[3], i === 0)}${x[4] ? selo(x[4].v, TR, x[4].pp) : ''}</div></div>`;
  }).join('');
  var cs = el('kpis').querySelectorAll('.kpi');
  for (var i = 0; i < cs.length; i++) (function (no, x, i) {
    dica(no, function () {
      var t = `<b>${x[0]}</b><br>Linha: evolução mês a mês de ${x[5]}.`;
      if (x[4]) t += `<br>Selo: ${m.length === 12 ? '4º trimestre contra o 1º' : 'últimos 3 meses contra os 3 primeiros'}` + (i < 3 ? ', pela média por dia de operação.' : '.');
      if (i === 5 && temC) t += `<br><br><b>Estrutura de custos estimada:</b><br>• Custo ingredientes (cobertura): ${usdc(ci)} (${pct(ci / k.f)})<br>• Custo massa, molho e embalagem: ${usdc(cprod - ci)} (${pct((cprod - ci) / k.f)})<br>• Custo produção, forno e equipe: ${usdc(custo - cprod - k.f * TAXA_V)}<br>• Impostos e taxas (16%): ${usdc(k.f * TAXA_V)}<br><b>Lucro líquido estimado: ${usdc(k.f - custo)} (${pct(mg)})</b>`;
      return t;
    });
  })(cs[i], c[i], i);
}

function barras(alvo, linhas, fmt, tipf) {
  var mx = Math.max.apply(null, linhas.map(function (r) { return r.v; }).concat([1]));
  var temTag = linhas.some(function (r) { return r.tag !== undefined; }), temSub = linhas.some(function (r) { return r.sub !== undefined; });
  el(alvo).innerHTML = linhas.map(function (r, i) {
    var vr = r.vr === undefined ? '' : r.vr == null ? `<div class='vr'></div>` : `<div class='vr ${r.vr >= 0 ? 'up' : 'dn'}'>${r.vr >= 0 ? '▲' : '▼'} ${pct(Math.abs(r.vr))}</div>`;
    return `<div class='b ${r.cls || ''}' data-i='${i}'><div class='lv'>${fmt(r.v)}</div>${vr}<div class='cw'><div class='col' style='height:${(r.v / mx * 100).toFixed(1)}%' data-h='${(r.v / mx * 100).toFixed(1)}'></div></div><div class='lx'>${esc(r.x)}</div>`
      + (temSub ? `<div class='ls'>${esc(r.sub || '')}</div>` : '') + (temTag ? `<div class='tg'>${esc(r.tag || '')}</div>` : '') + `</div>`;
  }).join('');
  var bs = el(alvo).querySelectorAll('.b');
  for (var i = 0; i < bs.length; i++) (function (b, r) { dica(b, function () { return tipf(r); }); })(bs[i], linhas[i]);
  setTimeout(function () {
    var cols = el(alvo).querySelectorAll('.col');
    for (var j = 0; j < cols.length; j++) cols[j].style.height = cols[j].getAttribute('data-h') + '%';
  }, 30);
}

function mensal(E) {
  el('mesSub').textContent = 'em US$ · ' + rotulo(E) + ' · ▲▼ média/dia';
  var vs = E.m.map(function (r) { return r[1]; }), mxv = Math.max.apply(null, vs), mnv = Math.min.apply(null, vs), marca = E.m.length > 2 && mxv > mnv;
  var linhas = E.m.map(function (r, i) {
    var md = r[3] ? r[1] / r[3] : 0, a = i ? E.m[i - 1] : null, ma = a && a[3] ? a[1] / a[3] : 0;
    var e = marca && r[1] === mxv ? 'max' : marca && r[1] === mnv ? 'min' : '';
    return { x: MES[r[0] - 1], v: r[1], vr: ma ? (md - ma) / ma : null, r: r, md: md, cls: e, tag: e === 'max' ? 'pico' : e === 'min' ? 'menor' : '' };
  });
  barras('mes', linhas, usdk, function (o) {
    var r = o.r;
    return `<b>${MESN[r[0] - 1]}</b>${o.tag ? ' · ' + o.tag : ''}<br>Faturamento: ${usd(r[1])}<br>Dias de operação: ${n(r[3])}<br>Média por dia: ${usd(o.md)}<br>Pedidos: ${n(r[2])}<br>Ticket médio: ${usd(r[2] ? r[1] / r[2] : 0)}`
      + (o.vr == null ? '' : `<br>Média por dia vs mês anterior: ${o.vr >= 0 ? '+' : '−'}${pct(Math.abs(o.vr))}`);
  });
}

function calor(E) {
  var mp = {}, mx = 1, mn = null, pico = null, hrs = {};
  D.h.forEach(function (r) { hrs[r[1]] = 1; });
  var HRS = Object.keys(hrs).map(Number).sort(function (a, b) { return a - b; });
  E.h.forEach(function (r) { mp[r[0] * 100 + r[1]] = r; if (r[2] > mx) { mx = r[2]; pico = r; } if (r[2] > 0 && (mn == null || r[2] < mn)) mn = r[2]; });
  var g = `<div class='hc hd'></div>` + HRS.map(function (h) { return `<div class='hc hd'>${h}h</div>`; }).join('');
  for (var d = 1; d <= 7; d++) {
    g += `<div class='hc dl'>${DIA[d - 1]}</div>`;
    HRS.forEach(function (h) {
      var r = mp[d * 100 + h], v = r ? r[2] : 0;
      var lt = st.tema === 'light'; var cor = v ? (lt ? 'rgba(234,88,12,' + (0.10 + 0.90 * v / mx).toFixed(3) + ')' : 'rgba(249,115,22,' + (0.14 + 0.86 * v / mx).toFixed(3) + ')') : (lt ? '#f1f5f9' : '#18181b');
      g += `<div class='hc cel${r && r === pico ? ' pico' : ''}' data-k='${d * 100 + h}' style='background:${cor}'></div>`;
    });
  }
  var box = el('calor');
  box.style.gridTemplateColumns = '34px repeat(' + HRS.length + ',minmax(0,1fr))';
  box.innerHTML = g;
  var cs = box.querySelectorAll('.cel');
  for (var i = 0; i < cs.length; i++) (function (c) {
    var k = +c.getAttribute('data-k'), r = mp[k], dd = Math.floor(k / 100), hh = k % 100;
    dica(c, function () {
      return `<b>${DIAN[dd - 1]}, ${hh}h–${hh + 1}h</b><br>` + (r ? `Faturamento: ${usd(r[2])} (${pct(r[2] / mx)} do pico)<br>Pedidos: ${n(r[3])}<br>Ticket médio: ${usd(r[3] ? r[2] / r[3] : 0)}` : 'Sem vendas');
    });
  })(cs[i]);
  el('calSub').textContent = pico ? 'pico: ' + DIAN[pico[0] - 1].toLowerCase() + ', ' + pico[1] + 'h · ' + rotulo(E) : rotulo(E);
  el('calLeg').innerHTML = `Cor = faturamento no período, por dia e hora: ${usdc(mn || 0)} <i></i> ${usdc(pico ? mx : 0)} · passe o mouse para ver pedidos`;
}

function mgCls(v) { return v >= 0.32 ? 'hi' : v < 0.22 ? 'lo' : 'md'; }

// Card central inferior: Categorias (mix + margem) ou Estoque crítico de ingredientes
function categorias(E) {
  var GK = D.gk || { d: 0 };
  var crit = (D.g || []).filter(function (g) { return g.fin < g.mn; }).length;
  el('catTit').textContent = st.catView === 'cat' ? 'Categorias · Mix & Margem' : 'Estoque de Insumos';
  el('segCat').innerHTML = `<button data-v='cat' class='${st.catView === 'cat' ? 'on' : ''}'>Categorias</button>`
    + `<button data-v='est' class='${st.catView === 'est' ? 'on' : ''}'>Estoque${crit ? `<span class='bdg-al'>${crit}</span>` : ''}</button>`;
  var bts = el('segCat').querySelectorAll('button');
  for (var b = 0; b < bts.length; b++) bts[b].onclick = function () {
    st.catView = this.getAttribute('data-v');
    categorias(E);
  };
  var box = el('cat');
  if (st.catView === 'cat') {
    var tot = D.c.reduce(function (a, r) { return a + r[1]; }, 0) || 1;
    var mx = Math.max.apply(null, D.c.map(function (r) { return r[1]; }).concat([1]));
    box.innerHTML = D.c.map(function (c, i) {
      var mt = D.catMeta[c[0]] || { mg: 0, cu: 0, cprod: 0 };
      var on = (E.s && E.s.c === c[0]) || st.catFil === c[0];
      return `<div class='citem${on ? ' on' : ''}' data-c='${esc(c[0])}' data-i='${i}'>`
        + `<div class='ctop'><span class='cn'>${esc(catPt(c[0]))}</span><span class='cf'>${usdc(c[1])} <small style='color:var(--sub);font-weight:700'>(${pct(c[1] / tot)})</small></span></div>`
        + `<div class='cmid'><span>${n(c[2])} pizzas · ${usd(c[2] ? c[1] / c[2] : 0)} / un</span><span class='mgp ${mgCls(mt.mg)}'>Margem ${pct(mt.mg)}</span></div>`
        + `<div class='tr'><div class='fi' style='width:${(c[1] / mx * 100).toFixed(1)}%'></div></div></div>`;
    }).join('');
    var its = box.querySelectorAll('.citem');
    for (var i = 0; i < its.length; i++) (function (no) {
      var catKey = no.getAttribute('data-c'), c = D.c[+no.getAttribute('data-i')], mt = D.catMeta[catKey] || { mg: 0, cu: 0, cprod: 0 };
      no.onclick = function () {
        st.catFil = st.catFil === catKey ? null : catKey;
        topo(E); categorias(E); tabela();
      };
      dica(no, function () {
        return `<b>Categoria ${esc(catPt(catKey))}</b><br>Faturamento: ${usd(c[1])} (${pct(c[1] / tot)})<br>Pizzas: ${n(c[2])} · Preço médio: ${usd(c[2] ? c[1] / c[2] : 0)}<br>Custo de produção: ${usd(mt.cprod)} (${pct(c[1] ? mt.cprod / c[1] : 0)})<br>Custo total estimado: ${usd(mt.cu)} (${pct(c[1] ? mt.cu / c[1] : 0)})<br>Margem líquida estimada: <b>${pct(mt.mg)}</b><br><i>Clique para ${st.catFil === catKey ? 'mostrar todas' : 'filtrar sabores desta categoria'}</i>`;
      });
    })(its[i]);
  } else {
    var lista = (D.g || []).map(function (g) {
      var med = GK.d ? g.co / GK.d : 0;
      var cob = med ? g.fin / med : 999;
      var status = g.fin < g.mn || cob < 3 ? 'crit' : cob < 7 ? 'att' : 'ok';
      return { g: g, med: med, cob: cob, status: status, pctAlvo: g.al ? Math.min(100, Math.max(4, g.fin / g.al * 100)) : 0 };
    }).sort(function (a, b) { return a.cob - b.cob; }).slice(0, 10);
    box.innerHTML = lista.map(function (x, i) {
      var lt = st.tema === 'light'; var cor = lt ? (x.status === 'crit' ? '#dc2626' : x.status === 'att' ? '#d97706' : '#059669') : (x.status === 'crit' ? '#fb7185' : x.status === 'att' ? '#f97316' : '#2bfdbe');
      var lb = x.status === 'crit' ? 'Crítico' : x.status === 'att' ? 'Atenção' : 'OK';
      return `<div class='est-row' data-i='${i}'><div class='est-top'><b>${esc(ingPt(x.g.n))}</b><span class='est-bdg ${x.status}'>${x.cob < 900 ? n1(x.cob) + 'd · ' : ''}${lb}</span></div>`
        + `<div class='est-meta'><span>Saldo: ${n1(kg(x.g.fin))} kg</span><span>Mín: ${n1(kg(x.g.mn))} kg</span></div>`
        + `<div class='est-tr'><div class='est-fi' style='width:${x.pctAlvo.toFixed(0)}%;background:${cor}'></div></div></div>`;
    }).join('') || `<div style='padding:12px;color:var(--sub);font-size:12px'>Sem dados de estoque.</div>`;
    var rows = box.querySelectorAll('.est-row');
    for (var j = 0; j < rows.length; j++) (function (no) {
      var x = lista[+no.getAttribute('data-i')], g = x.g;
      dica(no, function () {
        return `<b>${esc(ingPt(g.n))}</b> (${esc(g.g)})<br>Saldo atual: ${n1(kg(g.fin))} kg<br>Mínimo (3d): ${n1(kg(g.mn))} kg · Alvo (14d): ${n1(kg(g.al))} kg<br>Consumo médio: ${n1(kg(x.med))} kg/dia<br>Cobertura: <b>${x.cob < 900 ? n1(x.cob) + ' dias' : '–'}</b><br>Compra sugerida: ${n1(kg(Math.max(g.al - g.fin, 0)))} kg`;
      });
    })(rows[j]);
  }
}

function tamanhos(E) {
  var mp = {}, totq = 0, totf = 0;
  E.z.forEach(function (r) { mp[r[0]] = r; totq += r[2]; totf += r[1]; });
  var lista = TAM.filter(function (t) { return mp[t]; }), mxf = Math.max.apply(null, lista.map(function (t) { return mp[t][1]; }).concat([1]));
  var linhas = lista.map(function (t) {
    var r = mp[t];
    return { x: (TAML[t] || t) + ' · ' + pct(totf ? r[1] / totf : 0), v: r[1], r: r, sub: usd(r[2] ? r[1] / r[2] : 0), cls: r[1] === mxf ? 'max' : '' };
  });
  el('tamSub').textContent = 'US$ · preço/un · ' + rotulo(E);
  barras('tam', linhas, usdk, function (o) {
    var r = o.r;
    return `<b>${TAMN[r[0]]} (${TAML[r[0]] || r[0]})</b><br>Faturamento: ${usd(r[1])} · ${pct(totf ? r[1] / totf : 0)}<br>Pizzas: ${n(r[2])} · ${pct(totq ? r[2] / totq : 0)}<br>Preço médio: ${usd(r[2] ? r[1] / r[2] : 0)}`;
  });
  var fracos = lista.filter(function (t) { return totq && mp[t][2] / totq < 0.02; }).map(function (t) {
    var r = mp[t];
    return `${TAMN[t]} (${TAML[t] || t}): ${n(r[2])} pizzas (${pct(totf ? r[1] / totf : 0)}) → ` + (r[2] / totq < 0.005 ? 'avaliar descontinuação' : 'baixa saída, rever oferta');
  });
  var al = el('tamAl');
  al.style.display = fracos.length ? '' : 'none';
  al.innerHTML = fracos.length ? '⚠ ' + fracos.map(esc).join('<br>⚠ ') : '';
}

var COLS = [['#', null], ['Sabor', 'np'], ['Faturamento', 'f'], ['Pizzas', 'q'], ['Margem', 'mg'], ['Acum.', 'ac'], ['ABC', null]];
function tabela() {
  var o = st.ord, b = st.busca.toLowerCase();
  if (o.c === 'n' || o.c === 'p') o = st.ord = { c: 'f', d: -1 };
  var L = D.s.filter(function (s) {
    if (st.catFil && s.c !== st.catFil) return false;
    return !b || (s.np + ' ' + s.n + ' ' + catPt(s.c) + ' ' + s.c + ' ' + s.i + ' ' + ingsPt(s.i)).toLowerCase().indexOf(b) >= 0;
  });
  L.sort(function (a, c) { var x = a[o.c], y = c[o.c]; return (typeof x === 'string' ? x.localeCompare(y) : x - y) * o.d; });
  ULT = L;
  var temC = D.custo > 0, mx = Math.max.apply(null, D.s.map(function (s) { return s.f; }).concat([1]));
  var ordFat = o.c === 'f' && o.d < 0;
  el('segOrd').innerHTML = `<button data-d='-1' class='${ordFat ? 'on' : ''}'>Melhores</button><button data-d='1' class='${o.c === 'f' && o.d > 0 ? 'on' : ''}'>Piores</button>`;
  var sb = el('segOrd').querySelectorAll('button');
  for (var k = 0; k < sb.length; k++) sb[k].onclick = function () { st.ord = { c: 'f', d: +this.getAttribute('data-d') }; tabela(); };
  el('th').innerHTML = '<tr>' + COLS.map(function (c) {
    return `<th data-c='${c[1] || ''}'>${c[0]}${c[1] && c[1] === o.c ? (o.d < 0 ? ' ▼' : ' ▲') : ''}</th>`;
  }).join('') + '</tr>';
  var ths = el('th').querySelectorAll('th');
  for (var i = 0; i < ths.length; i++) ths[i].onclick = function () {
    var c = this.getAttribute('data-c'); if (!c) return;
    if (st.ord.c === c) st.ord.d = -st.ord.d; else st.ord = { c: c, d: c === 'np' || c === 'ac' ? 1 : -1 };
    tabela();
  };
  el('tb').innerHTML = L.map(function (s, i) {
    return `<tr class='${s.id === st.sel ? 'on' : ''}' data-id='${esc(s.id)}'><td>${i + 1}</td><td>${esc(s.np)}<small>${esc(catPt(s.c))}</small></td><td>${usd(s.f)}<span class='barra' style='width:${(s.f / mx * 34).toFixed(0)}px'></span></td><td>${n(s.q)}</td><td>${temC ? `<span class='mgp ${mgCls(s.mg)}'>${pct(s.mg)}</span>` : '–'}</td><td style='${ordFat ? '' : 'color:var(--sub)'}' title='Acumulado no ranking de faturamento'>${pct(s.ac)}</td><td><span class='abc ${s.abc}'>${s.abc}</span></td></tr>`;
  }).join('') || `<tr><td colspan='7' style='text-align:center;color:var(--sub)'>Nenhum sabor encontrado.</td></tr>`;
  var trs = el('tb').querySelectorAll('tr[data-id]');
  for (var j = 0; j < trs.length; j++) (function (tr) {
    var s = D.s.filter(function (x) { return x.id === tr.getAttribute('data-id'); })[0];
    tr.onclick = function () { escolher(s.id); };
    dica(tr, function () {
      return `<b>${esc(s.np)}</b> · classe ${s.abc} (${pct(s.ac)} acum.)<br>${esc(ingsPt(s.i))}<br><br>${pct(s.f / D.k.f)} do faturamento · ${n(s.p)} pedidos<br>Ticket médio: ${usd(s.p ? s.f / s.p : 0)}`
        + (temC ? `<br>Custo cobertura (pizza M): ${usd(s.cm)} · Custo produção: ${pct(s.cprod / s.f)}<br>Custo total: ${usd(s.cu)} · Margem líquida: <b>${pct(s.mg)}</b>` : '') + `<br>Clique para ${s.id === st.sel ? 'limpar o filtro' : 'filtrar a página'}`;
    });
  })(trs[j]);
  var sA = D.s.filter(function (s) { return s.abc === 'A'; }), sC = D.s.filter(function (s) { return s.abc === 'C'; });
  el('rod').textContent = n(L.length) + ' de ' + n(D.s.length) + ' sabores' + (st.catFil ? ' (' + catPt(st.catFil) + ')' : '') + ' · A: ' + n(sA.length) + ' (' + pct(sA.reduce(function (a, s) { return a + s.f; }, 0) / D.k.f) + ') · C: ' + sC.length + ' (' + pct(sC.reduce(function (a, s) { return a + s.f; }, 0) / D.k.f) + ') · clique para filtrar';
}

function exportar() {
  function dec(v, d) { return v.toLocaleString('pt-BR', { useGrouping: false, minimumFractionDigits: d, maximumFractionDigits: d }); }
  var cab = ['Sabor', 'Nome original', 'Categoria', 'Faturamento (US$)', 'Pizzas', 'Pedidos', '% do faturamento', '% acumulado', 'Classe ABC', 'Custo Ingredientes (US$)', 'Custo Produção (US$)', 'Custo Total Estimado (US$)', 'Margem Líquida (%)'];
  var lin = ULT.map(function (s) {
    return [s.np, s.n, catPt(s.c), dec(s.f / 100, 2), s.q, s.p, dec(s.f / D.k.f * 100, 2), dec(s.ac * 100, 2), s.abc, dec(s.ci / 100, 2), dec(s.cprod / 100, 2), dec(s.cu / 100, 2), dec(s.mg * 100, 1)];
  });
  var tsv = [cab].concat(lin).map(function (r) { return r.join('\t'); }).join('\r\n');
  var csv = '\uFEFF' + [cab].concat(lin).map(function (r) { return r.join(';'); }).join('\r\n');
  var m = el('modal');
  m.innerHTML = `<div class='box'><h2>Exportar sabores <button class='bt' id='mx'>Fechar</button></h2><div class='sub'>Copie e cole no Excel (as colunas já separam) ou baixe o CSV.</div><textarea id='mt' readonly></textarea><div class='acoes'><button class='bt' id='mc'>Copiar</button><button class='bt' id='mb'>Baixar .csv</button><span class='msg' id='mm'></span></div></div>`;
  m.style.display = 'flex';
  el('mt').value = tsv;
  el('mx').onclick = function () { m.style.display = 'none'; };
  el('mc').onclick = function () { el('mt').select(); var ok = false; try { ok = document.execCommand('copy'); } catch (e) {} el('mm').textContent = ok ? 'Copiado! Cole no Excel.' : 'Selecionado: use Ctrl+C.'; };
  el('mb').onclick = function () {
    if (window.pbi && window.pbi.baixar) {
      window.pbi.baixar(csv, 'sabores-pizzaria.csv').then(function (ok) { el('mm').textContent = ok ? 'Arquivo enviado para download.' : 'Download bloqueado: use Copiar.'; });
    } else {
      var a = document.createElement('a'); a.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv' })); a.download = 'sabores-pizzaria.csv'; a.click();
      el('mm').textContent = 'Arquivo baixado.';
    }
  };
}

function r2(x) { return Math.round((x || 0) * 100) / 100; }
function kg(g) { return Math.round((g || 0) / 10) / 100; }
function chaveIng(x) { x = String(x).trim().toLowerCase(); return x === 'artichokes' ? 'artichoke' : x; }
function receita(txt) { return String(txt || '').split(',').map(function (x) { return x.trim(); }).filter(function (x) { return x; }); }

function contexto() {
  var E = escopo(), dias = {}, horas = {};
  E.h.forEach(function (r) {
    var d = dias[r[0]] || (dias[r[0]] = { f: 0, p: 0 }); d.f += r[2]; d.p += r[3];
    var h = horas[r[1]] || (horas[r[1]] = { f: 0, p: 0 }); h.f += r[2]; h.p += r[3];
  });
  var pico = E.h.slice().sort(function (a, b) { return b[2] - a[2]; })[0];
  var G = {}, CAD = {}, usado = {}, GK = D.gk || { d: 0, ate: '' };
  (D.g || []).forEach(function (g) { G[chaveIng(g.n)] = g; });
  (D.cad || []).forEach(function (c) {
    CAD[c.id] = c;
    receita(c.i).forEach(function (nome) { var k = chaveIng(nome); (usado[k] || (usado[k] = [])).push(nomeS(c)); });
  });
  function precos(id) {
    var o = {}, c = CAD[id];
    if (c) TAM.forEach(function (t) { c.pr.forEach(function (p) { if (p[0] === t) o[t] = r2(p[1] / 100); }); });
    return o;
  }
  function estoqueSabor(txt) {
    var lim = null;
    var itens = receita(txt).map(function (nome) {
      var g = G[chaveIng(nome)];
      if (!g || !g.pm) return { ingrediente: ingPt(nome), rende_pizzas_M: null };
      var o = { ingrediente: ingPt(g.n), estoque_kg: kg(g.fin), rende_pizzas_M: Math.max(Math.floor(g.fin / (g.pm / 100)), 0) };
      o.cobertura_dias = GK.d && g.co ? Math.round(g.fin / (g.co / GK.d) * 10) / 10 : null;
      o.compra_sugerida_kg = kg(Math.max(g.al - g.fin, 0));
      if (g.fin < g.mn) o.abaixo_do_minimo = true;
      if (!lim || o.rende_pizzas_M < lim.rende_pizzas_M) lim = o;
      return o;
    });
    return { pizzas_M_possiveis_com_estoque_atual: lim ? lim.rende_pizzas_M : null, ingrediente_limitante: lim ? lim.ingrediente : null, ingredientes: itens };
  }
  function porMes(m, ix, dinheiro) { var o = {}; m.forEach(function (r) { o[MES[r[0] - 1]] = dinheiro ? r2(r[ix] / 100) : r[ix]; }); return o; }
  var sabores = D.s.map(function (s) {
    var dS = {}, hS = {}, od = {}, oh = {};
    s.h.forEach(function (r) { dS[r[0]] = (dS[r[0]] || 0) + r[2]; hS[r[1]] = (hS[r[1]] || 0) + r[2]; });
    Object.keys(dS).map(Number).sort(function (a, b) { return a - b; }).forEach(function (d) { od[DIA[d - 1]] = r2(dS[d] / 100); });
    Object.keys(hS).map(Number).sort(function (a, b) { return a - b; }).forEach(function (h) { oh[h + 'h'] = r2(hS[h] / 100); });
    return {
      sabor: s.np, nome_original: curto(s.n), categoria: catPt(s.c), classe_abc: s.abc, precos_usd: precos(s.id),
      custo_cobertura_pizza_M: r2(s.cm / 100), custo_producao: r2(s.cprod / 100), custo_total_estimado: r2(s.cu / 100), margem_liquida_pct: Math.round(s.mg * 1000) / 10,
      faturamento: r2(s.f / 100), pizzas: s.q, pedidos: s.p, dias_com_venda: s.d,
      faturamento_por_mes: porMes(s.m, 1, true), pedidos_por_mes: porMes(s.m, 2, false),
      por_tamanho: s.z.map(function (r) { return { tamanho: r[0], pizzas: r[2], faturamento: r2(r[1] / 100) }; }),
      faturamento_por_dia_semana: od, faturamento_por_hora: oh,
      estoque: estoqueSabor(s.i)
    };
  });
  var comVenda = {};
  D.s.forEach(function (s) { comVenda[s.id] = 1; });
  var semVenda = (D.cad || []).filter(function (c) { return !comVenda[c.id]; }).map(function (c) {
    return { sabor: nomeS(c), nome_original: curto(c.n), categoria: catPt(c.c), ingredientes: receita(c.i).map(ingPt), precos_usd: precos(c.id), estoque: estoqueSabor(c.i) };
  });
  var ingredientes = (D.g || []).map(function (g) {
    var med = GK.d ? g.co / GK.d : 0;
    return {
      ingrediente: ingPt(g.n), nome_original: g.n, grupo: g.g, porcao_pizza_M_g: g.pm / 100, custo_kg_usd: r2((g.cu || 0) / 100),
      estoque_atual_kg: kg(g.fin), estoque_minimo_kg: kg(g.mn), estoque_alvo_kg: kg(g.al),
      situacao: g.fin < 0 ? 'em ruptura' : g.fin < g.mn ? 'abaixo do mínimo' : 'ok',
      consumo_periodo_kg: kg(g.co), compras_periodo_kg: kg(g.en), consumo_medio_dia_kg: kg(med),
      cobertura_dias: med ? Math.round(g.fin / med * 10) / 10 : null, compra_sugerida_kg: kg(Math.max(g.al - g.fin, 0)), dias_abaixo_do_minimo_no_periodo: g.ab,
      consumo_kg_por_mes: g.m.map(function (r) { return kg(r[1]); }), estoque_kg_fim_do_mes: g.m.map(function (r) { return kg(r[2]); }),
      usado_nos_sabores: usado[chaveIng(g.n)] || []
    };
  }).sort(function (a, b) { return (a.cobertura_dias == null ? 1e9 : a.cobertura_dias) - (b.cobertura_dias == null ? 1e9 : b.cobertura_dias); });
  function pv(x, med) { return med ? Math.round((x / med - 1) * 100) : 0; }
  var hl = Object.keys(horas).map(Number).sort(function (a, b) { return a - b; });
  var totH = hl.reduce(function (a, h) { return a + horas[h].f; }, 0), medH = hl.length ? totH / hl.length : 0;
  var faixas = [], fx = null;
  hl.forEach(function (h) {
    if (horas[h].f >= medH) return;
    if (fx && fx.fim === h - 1) { fx.fim = h; fx.f += horas[h].f; fx.p += horas[h].p; fx.n++; }
    else { fx = { ini: h, fim: h, f: horas[h].f, p: horas[h].p, n: 1 }; faixas.push(fx); }
  });
  var pn = null;
  hl.forEach(function (h) { if (h >= 17 && (pn == null || horas[h].f > horas[pn].f)) pn = h; });
  var dl = Object.keys(dias).map(Number), medD = dl.length ? dl.reduce(function (a, d) { return a + dias[d].f; }, 0) / dl.length : 0;
  function mdia(r) { return r[3] ? r[1] / r[3] : 0; }
  var medM = E.m.length ? E.m.reduce(function (a, r) { return a + mdia(r); }, 0) / E.m.length : 0;
  var totQ = E.z.reduce(function (a, r) { return a + r[2]; }, 0), totF = E.z.reduce(function (a, r) { return a + r[1]; }, 0);
  var criticos = {
    horarios: {
      faturamento_medio_por_hora: r2(medH / 100),
      faixas_abaixo_da_media: faixas.map(function (x) {
        return { faixa: x.ini === x.fim ? x.ini + 'h' : x.ini + 'h a ' + x.fim + 'h', faturamento: r2(x.f / 100), pedidos: x.p,
          pct_do_faturamento_total: totH ? Math.round(x.f / totH * 1000) / 10 : 0, pct_vs_media_por_hora: pv(x.f / x.n, medH) };
      }),
      queda_apos_pico_da_noite: pn == null ? null : {
        pico_da_noite: pn + 'h', faturamento_no_pico: r2(horas[pn].f / 100),
        horas_seguintes: hl.filter(function (h) { return h > pn; }).map(function (h) {
          return { hora: h + 'h', faturamento: r2(horas[h].f / 100), pedidos: horas[h].p, queda_pct_vs_pico_da_noite: Math.round((1 - horas[h].f / horas[pn].f) * 100) };
        })
      }
    },
    dias_da_semana_mais_fracos: dl.sort(function (a, b) { return dias[a].f - dias[b].f; }).slice(0, 2).map(function (d) {
      return { dia: DIAN[d - 1], faturamento: r2(dias[d].f / 100), pct_vs_media_dos_dias: pv(dias[d].f, medD) };
    }),
    meses_mais_fracos_por_media_diaria: E.m.slice().sort(function (a, b) { return mdia(a) - mdia(b); }).slice(0, 3).map(function (r) {
      return { mes: MESN[r[0] - 1], faturamento_medio_por_dia: r2(mdia(r) / 100), dias_de_operacao: r[3], faturamento: r2(r[1] / 100), pct_vs_media_diaria_dos_meses: pv(mdia(r), medM) };
    }),
    tamanhos_de_baixa_saida: E.z.filter(function (r) { return totQ && r[2] / totQ < 0.02; }).map(function (r) {
      return { tamanho: r[0], pizzas: r[2], pct_das_pizzas: Math.round(r[2] / totQ * 1000) / 10, faturamento: r2(r[1] / 100), pct_do_faturamento: totF ? Math.round(r[1] / totF * 1000) / 10 : 0, sugestao: r[2] / totQ < 0.005 ? 'descontinuar ou reposicionar' : 'rever oferta' };
    }),
    sabores_com_menor_margem: D.s.slice().sort(function (a, b) { return a.mg - b.mg; }).slice(0, 5).map(function (s) {
      return { sabor: s.np, margem_liquida_pct: Math.round(s.mg * 1000) / 10, custo_producao: r2(s.cprod / 100), custo_total: r2(s.cu / 100), faturamento: r2(s.f / 100) };
    }),
    sabores_classe_C: D.s.filter(function (s) { return s.abc === 'C'; }).map(function (s) { return s.np; }),
    sabores_com_menor_faturamento: D.s.slice().sort(function (a, b) { return a.f - b.f; }).slice(0, 5).map(function (s) {
      return { sabor: s.np, categoria: catPt(s.c), classe_abc: s.abc, faturamento: r2(s.f / 100), pizzas: s.q };
    }),
    ingredientes_com_menor_cobertura: ingredientes.slice(0, 5).map(function (g) {
      return { ingrediente: g.ingrediente, cobertura_dias: g.cobertura_dias, estoque_atual_kg: g.estoque_atual_kg, compra_sugerida_kg: g.compra_sugerida_kg, situacao: g.situacao };
    })
  };
  var cuEsc = E.s ? E.s.cu : D.custo, cmvEsc = E.s ? E.s.cprod : D.cprod;
  return {
    escopo: E.s ? 'sabor ' + E.s.n : 'todos os sabores', periodo: dt(D.k.de) + ' a ' + dt(D.k.ate), moeda: 'USD',
    notas: [
      'vendas_do_escopo segue o sabor selecionado no painel; sabores, cadastro e estoque trazem sempre tudo.',
      'Pizza não tem estoque próprio: sabores[].estoque mostra quantas pizzas médias (M) o estoque atual dos ingredientes rende e qual ingrediente limita.',
      'Fator de consumo por tamanho em relação à pizza M: S 0,70 | M 1,00 | L 1,35 | XL 1,70 | XXL 2,10.',
      'Reposição: compra semanal às segundas-feiras, completando até estoque_alvo (14 dias de consumo médio); estoque_minimo equivale a 3 dias de consumo.',
      'Estrutura de custos por pizza média equivalente (P 0,70 | M 1,00 | G 1,35 | GG 1,70 | XGG 2,10): Custo de produção = ingredientes da receita + massa, molho e embalagem (US$ 2,90 por pizza M equivalente); Custo total = custo de produção + operação/forno/equipe (US$ 3,20 por pizza M equivalente) + impostos e taxas (16% do faturamento). Classe ABC (sobre acumulado): A até 80%, B até 95%, C acima de 95%.',
      'Compare meses pela média por dia de operação (faturamento_medio_por_dia), não pelo total: meses têm quantidades diferentes de dias.'
    ],
    pontos_criticos: criticos,
    vendas_do_escopo: {
      kpis: { faturamento: r2(E.k.f / 100), pedidos: E.k.p, pizzas: E.k.q, dias_com_venda: E.k.d,
        ticket_medio: E.k.p ? r2(E.k.f / E.k.p / 100) : 0, pizzas_por_pedido: E.k.p ? r2(E.k.q / E.k.p) : 0,
        custo_producao_estimado: r2(cmvEsc / 100), custo_total_estimado: r2(cuEsc / 100), margem_liquida_pct: E.k.f ? Math.round((1 - cuEsc / E.k.f) * 1000) / 10 : null },
      por_mes: E.m.map(function (r) { return { mes: MESN[r[0] - 1], faturamento: r2(r[1] / 100), pedidos: r[2], pizzas: r[4], dias_de_operacao: r[3], faturamento_medio_por_dia: r2(r[3] ? r[1] / r[3] / 100 : 0) }; }),
      por_dia_semana: Object.keys(dias).sort().map(function (d) { return { dia: DIAN[d - 1], faturamento: r2(dias[d].f / 100), pedidos: dias[d].p }; }),
      por_hora: Object.keys(horas).map(Number).sort(function (a, b) { return a - b; }).map(function (h) { return { hora: h + 'h', faturamento: r2(horas[h].f / 100), pedidos: horas[h].p }; }),
      horario_de_pico: pico ? DIAN[pico[0] - 1] + ' ' + pico[1] + 'h' : null,
      por_tamanho: E.z.map(function (r) { return { tamanho: (TAMN[r[0]] || r[0]) + ' (' + r[0] + ')', faturamento: r2(r[1] / 100), pizzas: r[2] }; })
    },
    categorias: D.c.map(function (r) { var mt = D.catMeta[r[0]] || { mg: 0, cu: 0, cprod: 0 }; return { categoria: catPt(r[0]), faturamento: r2(r[1] / 100), pizzas: r[2], custo_producao: r2(mt.cprod / 100), custo_total: r2(mt.cu / 100), margem_liquida_pct: Math.round(mt.mg * 1000) / 10 }; }),
    sabores: sabores,
    sabores_cadastrados_sem_vendas: semVenda,
    estoque: {
      data_referencia: GK.ate ? dt(GK.ate) : null, dias_no_periodo: GK.d, meses: D.m.map(function (r) { return MES[r[0] - 1]; }),
      total_atual_kg: kg((D.g || []).reduce(function (a, g) { return a + g.fin; }, 0)),
      ingredientes_abaixo_do_minimo: (D.g || []).filter(function (g) { return g.fin < g.mn; }).map(function (g) { return ingPt(g.n); }),
      ingredientes: ingredientes
    }
  };
}

function md(t) {
  var out = [], lista = false;
  function b(x) { return x.replace(/\*\*(.+?)\*\*/g, '<b>$1</b>').replace(/(^|[^*])\*([^*]+)\*/g, '$1<i>$2</i>'); }
  esc(t).split(/\r?\n/).forEach(function (l) {
    var x = l.trim();
    if (/^([-*•]|\d+[.)])\s+/.test(x)) {
      if (!lista) { out.push('<ul>'); lista = true; }
      out.push('<li>' + b(x.replace(/^([-*•]|\d+[.)])\s+/, '')) + '</li>'); return;
    }
    if (lista) { out.push('</ul>'); lista = false; }
    if (/^#{1,6}\s+/.test(x)) out.push('<h3>' + b(x.replace(/^#{1,6}\s+/, '')) + '</h3>');
    else if (x) out.push('<p>' + b(x) + '</p>');
  });
  if (lista) out.push('</ul>');
  return out.join('');
}

function iaChamar(prompt, op) { return new Promise(function (ok) { ok(api.perguntarIA(prompt, op)); }); }

var DIG = `<span class='iadig'><i></i><i></i><i></i></span>`;
var SUG = ['Qual o estoque atual da pizza Frango Tailandês?', 'Quais sabores têm a pior margem líquida?', 'Quais ingredientes estão em nível crítico?', 'Qual foi o melhor mês e por quê?', 'Como melhorar a margem de Quatro e Cinco Queijos?', 'Em que dia e horário devo reforçar a equipe?'];
var BASES = 'O contexto traz TODAS as bases do modelo cruzadas: vendas (mês, dia da semana, hora, tamanho, categoria e sabor), cadastro (sabores, categorias, ingredientes e preços por tamanho), estrutura completa de custos (margem líquida = faturamento menos custo de produção com insumos/massa/embalagem, custo operacional/equipe e impostos/taxas), curva ABC e estoque de ingredientes. Regras: (1) para estoque de pizza/sabor use sabores[].estoque (quantas pizzas M rende e ingrediente limitante); (2) aceite nomes aproximados; (3) use apenas números do contexto; valores em US$, estoque em kg/g; (4) ao explicar custos, use termos claros como Custo de Produção, Custo Operacional e Custo Total (sem usar siglas ou jargões contábeis abreviados).';

function iaAbrir() { st.ia.modo = 'menu'; iaRender(); }

function iaAnalise() {
  var I = st.ia, ctx = contexto();
  I.analise = { escopo: ctx.escopo, carregando: true, txt: '', erro: '' };
  iaRender();
  iaChamar('Você é a Pizz.IA, analista de BI e controladoria sênior de uma pizzaria. Escreva em português do Brasil uma análise executiva dos dados enviados, usando exatamente estas seções markdown (###): ### Resumo, ### Vendas ao longo do ano, ### Dias e horários, ### Sabores, categorias e margem, ### Tamanhos e preços, ### Estoque de ingredientes, ### Recomendações. Em cada seção use 2 a 4 tópicos curtos com números. Nas recomendações, dê 3 a 5 ações práticas cruzando margem, vendas e estoque e atacando pontos_criticos. ' + BASES, { dados: ctx, temperatura: 0.3 })
    .then(function (t) { I.analise.txt = t; })
    .catch(function (e) { I.analise.erro = e && e.message ? e.message : String(e); })
    .then(function () { I.analise.carregando = false; iaRender(); });
}

function iaPerguntar(q) {
  var I = st.ia;
  q = (q || '').trim();
  if (!q || I.esperando) return;
  var hist = I.chat.filter(function (m) { return m.r !== 'e'; }).slice(-10).map(function (m) { return (m.r === 'u' ? 'Usuário: ' : 'Assistente: ') + m.t; }).join('\n');
  I.chat.push({ r: 'u', t: q }); I.esperando = true; I.rascunho = '';
  iaRender();
  iaChamar('Você é a Pizz.IA, assistente analítica de BI dentro do Power BI. Responda em português do Brasil, de forma direta (até 6 frases ou lista curta). Termine SEMPRE com **Recomendação:** com ação prática e números do contexto (para estoque: kg a comprar e urgência; para vendas/margem: ajuste de preço, porção, promoção por faixa horária ou escala). ' + BASES
      + (hist ? '\n\nConversa até agora:\n' + hist : '') + '\n\nPergunta atual do usuário: ' + q, { dados: contexto(), temperatura: 0.3 })
    .then(function (t) { I.chat.push({ r: 'a', t: t }); })
    .catch(function (e) { I.chat.push({ r: 'e', t: 'Não foi possível responder: ' + (e && e.message ? e.message : e) }); })
    .then(function () { I.esperando = false; iaRender(); });
}

function iaRender() {
  var p = el('iaP'), I = st.ia;
  if (!p) return;
  if (!I.modo) { p.className = ''; p.innerHTML = ''; return; }
  p.className = 'on';
  var esc0 = `<span class='iaesc'>Dados: ${esc(rotulo(escopo()))} · vendas, margem e estoque</span>`;
  var pizza = `<svg viewBox='0 0 24 24' width='16' height='16' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='flex-shrink:0'><path d='M12 2L2 19a15 15 0 0 0 20 0Z'/><path d='M4 15.6a12 12 0 0 0 16 0'/><circle cx='12' cy='9.5' r='1' fill='currentColor'/><circle cx='9.5' cy='13.5' r='1' fill='currentColor'/><circle cx='14.5' cy='13' r='1' fill='currentColor'/></svg>`;
  var tit = { menu: pizza + '<span>Pizz.IA</span>', analise: '📊 Análise executiva', chat: '💬 Chat · Pizz.IA' }[I.modo];
  var bts = (I.modo !== 'menu' ? `<button id='iaV' title='Voltar às opções'>←</button>` : '') + `<b>${tit}</b>`
    + (I.modo === 'chat' && I.chat.length ? `<button id='iaL' title='Apagar a conversa'>Limpar</button>` : '') + `<button id='iaF' title='Fechar'>✕</button>`;
  var corpo = '', pe = '';
  if (I.modo === 'menu') {
    corpo = esc0 + `<button class='iaop' data-m='analise'><div class='t'>📊 Análise executiva</div><div class='d'>Diagnóstico completo de faturamento, custos, margem líquida, sazonalidade, horários, categorias e estoque.</div></button>`
      + `<button class='iaop' data-m='chat'><div class='t'>💬 Chat analítico</div><div class='d'>Pergunte sobre rentabilidade, ruptura de insumos, receitas, horários de pico e recomendações de ação.</div></button>`;
  } else if (I.modo === 'analise') {
    var A = I.analise;
    corpo = `<span class='iaesc'>Dados: ${esc(A ? A.escopo : rotulo(escopo()))}</span>`;
    if (!A || A.carregando) corpo += `<div class='iamsg a'>${DIG}Gerando análise executiva...</div>`;
    else if (A.erro) corpo += `<div class='iamsg e'>Não foi possível gerar a análise: ${esc(A.erro)}</div><button class='iabt' id='iaR'>Tentar de novo</button>`;
    else corpo += `<div class='iamd'>${md(A.txt)}</div><button class='iabt' id='iaR'>↻ Atualizar análise com filtros atuais</button>`;
  } else {
    corpo = esc0;
    if (!I.chat.length) corpo += `<div class='iaintro'>A Pizz.IA cruza vendas, estrutura de custos, receitas e estoque para responder direto com plano de ação.</div><div class='iasug'>`
      + SUG.map(function (q, i) { return `<button data-q='${i}'>${esc(q)}</button>`; }).join('') + `</div>`;
    corpo += I.chat.map(function (m) { return `<div class='iamsg ${m.r}'>` + (m.r === 'a' ? `<div class='iamd'>${md(m.t)}</div>` : esc(m.t)) + `</div>`; }).join('');
    if (I.esperando) corpo += `<div class='iamsg a'>${DIG}Analisando vendas, custos e estoque...</div>`;
    pe = `<div class='iaf'><textarea id='iaT' placeholder='Digite sua pergunta... (Enter envia)'></textarea><button id='iaE'${I.esperando ? ' disabled' : ''}>Enviar</button></div>`;
  }
  p.innerHTML = `<div class='iah'>${bts}</div><div class='iab' id='iaB'>${corpo}</div>` + pe;

  el('iaF').onclick = function () { I.modo = null; iaRender(); };
  if (el('iaV')) el('iaV').onclick = function () { I.modo = 'menu'; iaRender(); };
  if (el('iaL')) el('iaL').onclick = function () { I.chat = []; iaRender(); };
  if (el('iaR')) el('iaR').onclick = iaAnalise;
  var ops = p.querySelectorAll('.iaop');
  for (var i = 0; i < ops.length; i++) ops[i].onclick = function () {
    I.modo = this.getAttribute('data-m');
    if (I.modo === 'analise' && (!I.analise || (!I.analise.carregando && I.analise.escopo !== (escopo().s ? 'sabor ' + escopo().s.n : 'todos os sabores')))) iaAnalise();
    else iaRender();
  };
  var sg = p.querySelectorAll('.iasug button');
  for (var j = 0; j < sg.length; j++) sg[j].onclick = function () { iaPerguntar(SUG[+this.getAttribute('data-q')]); };
  var tx = el('iaT');
  if (tx) {
    tx.value = I.rascunho || '';
    tx.oninput = function () { I.rascunho = this.value; };
    tx.onkeydown = function (e) { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); iaPerguntar(this.value); } };
    el('iaE').onclick = function () { iaPerguntar(tx.value); };
    if (!I.esperando) tx.focus();
  }
  var bx = el('iaB'); if (I.modo === 'chat') bx.scrollTop = bx.scrollHeight;
}

function tudo() {
  if (st.sel && !item()) { st.sel = null; api.limpar(); }
  var E = escopo();
  topo(E); kpis(E); mensal(E); calor(E); categorias(E); tamanhos(E); tabela(); iaRender();
}

var bu = el('busca');
bu.value = st.busca;
bu.oninput = function () { st.busca = this.value; tabela(); };
el('btX').onclick = exportar;
el('modal').onclick = function (e) { if (e.target === this) this.style.display = 'none'; };
aplicarTema();
prep();
tudo();"
RETURN
    IF( ISBLANK( [Faturamento] ), "<div style='padding:16px;font:13px sans-serif;color:#efeff1;background:#0c0c0e'>Sem dados para os filtros atuais.</div>", _css & _html & "<script>(function(){" & _dados & _js & "})();</script>" )
