			  }).join('') || `<tr><td colspan='7' style='text-align:center;color:#6b7280'>Nenhum sabor encontrado.</td></tr>`;
			  var trs = el('tb').querySelectorAll('tr[data-id]');
			  for (var j = 0; j < trs.length; j++) (function (tr) {
			    var s = D.s.filter(function (x) { return x.id === tr.getAttribute('data-id'); })[0];
			    tr.onclick = function () { escolher(s.id); };
			    dica(tr, function () {
			      return `<b>${esc(s.np)}</b> · classe ${s.abc} (${pct(s.ac)} acum.)<br>${esc(ingsPt(s.i))}<br><br>${pct(s.f / D.k.f)} do faturamento · ${n(s.p)} pedidos<br>Ticket médio: ${usd(s.p ? s.f / s.p : 0)}`
			        + (temC ? `<br>Custo cobertura (pizza M): ${usd(s.cm)} · Custo produção: ${pct(s.cprod / s.f)}<br>Custo total: ${usd(s.cu)} · Margem líquida: <b>${pct(s.mg)}</b>` : '') + `<br>Clique para ${s.id === st.sel ? 'limpar o filtro' : 'filtrar a página'}`;
			    });
			  })(trs[j]);
			  var sA = D.s.filter(function (s) { return s.abc === 'A'; }), sC = D.s.filter(function (s) { return s.abc === 'C'; });
			  el('rod').textContent = n(L.length) + ' de ' + n(D.s.length) + ' sabores' + (st.catFil ? ' (' + catPt(st.catFil) + ')' : '') + ' · A: ' + n(sA.length) + ' (' + pct(sA.reduce(function (a, s) { return a + s.f; }, 0) / D.k.f) + ') · C: ' + sC.length + ' (' + pct(sC.reduce(function (a, s) { return a + s.f; }, 0) / D.k.f) + ') · clique para filtrar';
			}
			
			function exportar() {
			  function dec(v, d) { return v.toLocaleString('pt-BR', { useGrouping: false, minimumFractionDigits: d, maximumFractionDigits: d }); }
			  var cab = ['Sabor', 'Nome original', 'Categoria', 'Faturamento (US$)', 'Pizzas', 'Pedidos', '% do faturamento', '% acumulado', 'Classe ABC', 'Custo Ingredientes (US$)', 'Custo Produção (US$)', 'Custo Total Estimado (US$)', 'Margem Líquida (%)'];
			  var lin = ULT.map(function (s) {
			    return [s.np, s.n, catPt(s.c), dec(s.f / 100, 2), s.q, s.p, dec(s.f / D.k.f * 100, 2), dec(s.ac * 100, 2), s.abc, dec(s.ci / 100, 2), dec(s.cprod / 100, 2), dec(s.cu / 100, 2), dec(s.mg * 100, 1)];
			  });
			  var tsv = [cab].concat(lin).map(function (r) { return r.join('\t'); }).join('\r\n');
			  var csv = '\uFEFF' + [cab].concat(lin).map(function (r) { return r.join(';'); }).join('\r\n');
			  var m = el('modal');
			  m.innerHTML = `<div class='box'><h2>Exportar sabores <button class='bt' id='mx'>Fechar</button></h2><div class='sub'>Copie e cole no Excel (as colunas já separam) ou baixe o CSV.</div><textarea id='mt' readonly></textarea><div class='acoes'><button class='bt' id='mc'>Copiar</button><button class='bt' id='mb'>Baixar .csv</button><span class='msg' id='mm'></span></div></div>`;
			  m.style.display = 'flex';
			  el('mt').value = tsv;
			  el('mx').onclick = function () { m.style.display = 'none'; };
			  el('mc').onclick = function () { el('mt').select(); var ok = false; try { ok = document.execCommand('copy'); } catch (e) {} el('mm').textContent = ok ? 'Copiado! Cole no Excel.' : 'Selecionado: use Ctrl+C.'; };
			  el('mb').onclick = function () {
			    if (window.pbi && window.pbi.baixar) {
			      window.pbi.baixar(csv, 'sabores-pizzaria.csv').then(function (ok) { el('mm').textContent = ok ? 'Arquivo enviado para download.' : 'Download bloqueado: use Copiar.'; });
			    } else {
			      var a = document.createElement('a'); a.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv' })); a.download = 'sabores-pizzaria.csv'; a.click();
			      el('mm').textContent = 'Arquivo baixado.';
			    }
			  };
			}
			
			function r2(x) { return Math.round((x || 0) * 100) / 100; }
			function kg(g) { return Math.round((g || 0) / 10) / 100; }
			function chaveIng(x) { x = String(x).trim().toLowerCase(); return x === 'artichokes' ? 'artichoke' : x; }
			function receita(txt) { return String(txt || '').split(',').map(function (x) { return x.trim(); }).filter(function (x) { return x; }); }
			
			function contexto() {
			  var E = escopo(), dias = {}, horas = {};
			  E.h.forEach(function (r) {
			    var d = dias[r[0]] || (dias[r[0]] = { f: 0, p: 0 }); d.f += r[2]; d.p += r[3];
			    var h = horas[r[1]] || (horas[r[1]] = { f: 0, p: 0 }); h.f += r[2]; h.p += r[3];
			  });
			  var pico = E.h.slice().sort(function (a, b) { return b[2] - a[2]; })[0];
			  var G = {}, CAD = {}, usado = {}, GK = D.gk || { d: 0, ate: '' };
			  (D.g || []).forEach(function (g) { G[chaveIng(g.n)] = g; });
			  (D.cad || []).forEach(function (c) {
			    CAD[c.id] = c;
			    receita(c.i).forEach(function (nome) { var k = chaveIng(nome); (usado[k] || (usado[k] = [])).push(nomeS(c)); });
			  });
			  function precos(id) {
			    var o = {}, c = CAD[id];
			    if (c) TAM.forEach(function (t) { c.pr.forEach(function (p) { if (p[0] === t) o[t] = r2(p[1] / 100); }); });
			    return o;
			  }
			  function estoqueSabor(txt) {
			    var lim = null;
			    var itens = receita(txt).map(function (nome) {
			      var g = G[chaveIng(nome)];
			      if (!g || !g.pm) return { ingrediente: ingPt(nome), rende_pizzas_M: null };
			      var o = { ingrediente: ingPt(g.n), estoque_kg: kg(g.fin), rende_pizzas_M: Math.max(Math.floor(g.fin / (g.pm / 100)), 0) };
			      o.cobertura_dias = GK.d && g.co ? Math.round(g.fin / (g.co / GK.d) * 10) / 10 : null;
			      o.compra_sugerida_kg = kg(Math.max(g.al - g.fin, 0));
