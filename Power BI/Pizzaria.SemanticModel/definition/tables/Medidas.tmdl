			      });
			    })(rows[j]);
			  }
			}
			
			function tamanhos(E) {
			  var mp = {}, totq = 0, totf = 0;
			  E.z.forEach(function (r) { mp[r[0]] = r; totq += r[2]; totf += r[1]; });
			  var lista = TAM.filter(function (t) { return mp[t]; }), mxf = Math.max.apply(null, lista.map(function (t) { return mp[t][1]; }).concat([1]));
			  var linhas = lista.map(function (t) {
			    var r = mp[t];
