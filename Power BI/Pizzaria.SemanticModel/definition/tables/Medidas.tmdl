			      var status = g.fin < g.mn || cob < 3 ? 'crit' : cob < 7 ? 'att' : 'ok';
			      return { g: g, med: med, cob: cob, status: status, pctAlvo: g.al ? Math.min(100, Math.max(4, g.fin / g.al * 100)) : 0 };
			    }).sort(function (a, b) { return a.cob - b.cob; }).slice(0, 10);
			    box.innerHTML = lista.map(function (x, i) {
			      var cor = x.status === 'crit' ? '#dc2626' : x.status === 'att' ? '#d97706' : '#059669';
			      var lb = x.status === 'crit' ? 'Crítico' : x.status === 'att' ? 'Atenção' : 'OK';
			      return `<div class='est-row' data-i='${i}'><div class='est-top'><b>${esc(ingPt(x.g.n))}</b><span class='est-bdg ${x.status}'>${x.cob < 900 ? n1(x.cob) + 'd · ' : ''}${lb}</span></div>`
			        + `<div class='est-meta'><span>Saldo: ${n1(kg(x.g.fin))} kg</span><span>Mín: ${n1(kg(x.g.mn))} kg</span></div>`
