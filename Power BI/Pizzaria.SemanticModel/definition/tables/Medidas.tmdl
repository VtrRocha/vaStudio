/// Tabela dedicada às medidas do modelo da pizzaria.
table Medidas
	lineageTag: c2c2d407-39a9-4ea7-8abc-91a4587be783

	/// Valor vendido: quantidade × preço da pizza (US$).
	measure Faturamento =
			SUMX(
			    fItemPedido,
			    fItemPedido[Quantidade] * RELATED(dPizza[Preço])
			)
		formatString: \$#,0.00
		displayFolder: Vendas
		lineageTag: 085411bf-e4a7-4cc0-979e-d581f7644f7e

	/// Quantidade total de pizzas vendidas.
	measure 'Pizzas Vendidas' = SUM(fItemPedido[Quantidade])
		formatString: #,0
		displayFolder: Vendas
		lineageTag: d72c539c-d540-4be5-93b0-1a88ed881343

	/// Número de pedidos distintos (conta pelos itens, para respeitar filtros de sabor e tamanho).
	measure Pedidos = DISTINCTCOUNT(fItemPedido[ID Pedido])
		formatString: #,0
		displayFolder: Vendas
		lineageTag: 01402cb0-653d-4031-9994-1ab00c9ab0d9

	/// Dias com pelo menos um pedido no contexto.
	measure 'Dias com Venda' = COUNTROWS(SUMMARIZE(fItemPedido, dPedido[Data]))
		formatString: #,0
		displayFolder: Vendas
		lineageTag: 3189950e-0293-4bda-857f-9d418792d436

	/// Faturamento médio por pedido.
	measure 'Ticket Médio' = DIVIDE([Faturamento], [Pedidos])
		formatString: \$#,0.00
		displayFolder: Indicadores
		lineageTag: d550520c-07cd-465a-862c-7596f9d56ec4

	/// Média de pizzas em cada pedido.
	measure 'Pizzas por Pedido' = DIVIDE([Pizzas Vendidas], [Pedidos])
		formatString: #,0.00
		displayFolder: Indicadores
		lineageTag: 68ab750a-493b-4334-b466-95ebb1fd80d7

	/// Faturamento dividido pelas pizzas vendidas.
	measure 'Preço Médio por Pizza' = DIVIDE([Faturamento], [Pizzas Vendidas])
		formatString: \$#,0.00
		displayFolder: Indicadores
		lineageTag: 436a971a-c7b3-4096-ba63-4439d28dc8fb

	/// Faturamento dividido pelos dias com venda.
	measure 'Faturamento Médio por Dia' = DIVIDE([Faturamento], [Dias com Venda])
		formatString: \$#,0.00
		displayFolder: Indicadores
		lineageTag: 91ae9234-1546-4959-909d-d37ad644f42c

	/// Participação no faturamento do que está selecionado no visual/página.
	measure '% do Faturamento' =
			DIVIDE(
			    [Faturamento],
			    CALCULATE([Faturamento], ALLSELECTED())
			)
		formatString: 0.0%
		displayFolder: Indicadores
		lineageTag: a4b78e02-8b84-4382-952f-769504e23023

	/// Faturamento acumulado do início do ano até a data do contexto.
	measure 'Faturamento Acumulado no Ano' = TOTALYTD([Faturamento], dCalendario[Data])
		formatString: \$#,0.00
		displayFolder: Tempo
		lineageTag: 7c745a72-7ae4-42f5-b565-05d02317da22

	/// Faturamento do mês anterior ao contexto.
	measure 'Faturamento Mês Anterior' =
			CALCULATE(
			    [Faturamento],
			    DATEADD(dCalendario[Data], -1, MONTH)
			)
		formatString: \$#,0.00
		displayFolder: Tempo
		lineageTag: 920c59aa-d3f8-4d9f-bf09-61308e394f71

	/// Variação percentual do faturamento contra o mês anterior (em branco quando não há mês anterior).
	measure 'Variação vs Mês Anterior %' =
			VAR _anterior = [Faturamento Mês Anterior]
			RETURN
			    IF(
			        NOT ISBLANK(_anterior),
			        DIVIDE([Faturamento] - _anterior, _anterior)
			    )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Tempo
		lineageTag: c75a3464-4222-4d2b-a7e7-d0e55b816086

	/// Dashboard da pizzaria em HTML + CSS + JS para o visual HTML JS Studio (modularizado em componentes DAX): indicadores com margem líquida realista, faturamento mensal, mapa de calor dia × hora, card Categorias & Estoque, tamanhos e tabela de sabores (curva ABC + filtro cruzado). Botão Pizz.IA (quando Gemini estiver configurado) abre análise executiva ou chat com vendas, rentabilidade, cadastro e estoque cruzados.
	measure 'HTML Dashboard Pizzaria' =
			VAR _f = [Faturamento]
			VAR _html = "<div id='app'>
			<div class='cab'><div class='topo'><div><h1>🍕 Pizzaria · Painel de vendas</h1><div class='sub' id='sub'></div></div><div class='acoes'><button id='btTema' class='bt tema' title='Alternar layout Black / White'></button><button id='btIA' class='bt ia' style='display:none'><svg viewBox='0 0 24 24' width='15' height='15' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='flex-shrink:0'><path d='M12 2L2 19a15 15 0 0 0 20 0Z'/><path d='M4 15.6a12 12 0 0 0 16 0'/><circle cx='12' cy='9.5' r='1' fill='currentColor'/><circle cx='9.5' cy='13.5' r='1' fill='currentColor'/><circle cx='14.5' cy='13' r='1' fill='currentColor'/></svg><span>Pizz.IA</span></button><button id='btLimpar' class='chip sel' style='display:none'></button></div></div></div>
			<div class='kpis' id='kpis'></div>
			<div class='card mes'><h2><span id='mesTit'>Faturamento por mês</span><small id='mesSub'></small></h2><div class='bars' id='mes'></div></div>
			<div class='card calor'><h2>Quando a pizzaria vende <small id='calSub'></small></h2><div id='calor'></div><div class='leg' id='calLeg'></div></div>
			<div class='card tab'><h2>Sabores <span class='tb'><span class='seg' id='segOrd'></span><input id='busca' placeholder='Buscar sabor...'><button id='btX' class='bt'>⬇ Excel</button></span></h2><div class='tw'><table><thead id='th'></thead><tbody id='tb'></tbody></table></div><div class='rod' id='rod'></div></div>
			<div class='card cat'><h2><span id='catTit'>Categorias · Mix &amp; Margem</span><span class='seg' id='segCat'></span></h2><div id='cat'></div></div>
			<div class='card tam'><h2>Tamanhos <small id='tamSub'></small></h2><div class='bars' id='tam'></div><div class='alerta' id='tamAl' style='display:none'></div></div>
			</div><div id='tip'></div><div id='modal'></div><div id='iaP'></div>"
			RETURN
			    IF(
			        ISBLANK( _f ),
			        "<div style='padding:24px;font-family:Segoe UI;color:#6b7280'>Sem vendas no filtro atual.</div>",
			        [_HTML CSS Painel] & _html & "<script>(function(){" & [_HTML Dados Vendas] & [_HTML Dados Estoque] & [_HTML JS Painel] & "})();</script>"
			    )
		displayFolder: Visuais HTML
		lineageTag: 4e33b7f6-23cf-4129-9249-c3c0c508b95f

	/// Gramas de ingrediente consumidas no período (vendas × porção × fator do tamanho).
	measure 'Consumo (g)' = SUM ( fEstoque[Consumo] )
		formatString: #,0" g"
		displayFolder: Estoque
		lineageTag: 17de4460-9edc-458b-8186-d899651d1ee0

	/// Gramas compradas no período (reposição simulada às segundas-feiras).
	measure 'Compras (g)' = SUM ( fEstoque[Entrada] )
		formatString: #,0" g"
		displayFolder: Estoque
		lineageTag: b8a84118-0c68-4498-a665-a50ed6e9c130

	/// Saldo no primeiro dia do período selecionado (semiaditivo: não soma entre dias).
	measure 'Estoque Inicial (g)' = CALCULATE ( SUM ( fEstoque[Estoque Inicial] ), FIRSTDATE ( dCalendario[Data] ) )
		formatString: #,0" g"
		displayFolder: Estoque
		lineageTag: debaa88e-bda9-4994-a4c5-5990790be072

	/// Saldo no último dia com movimento do período selecionado (semiaditivo: não soma entre dias).
	measure 'Estoque Final (g)' =
			VAR UltimaData =
			    CALCULATE ( MAX ( fEstoque[Data] ), ALLSELECTED ( dIngrediente ) )
			RETURN
			    CALCULATE ( SUM ( fEstoque[Estoque Final] ), dCalendario[Data] = UltimaData )
		formatString: #,0" g"
		displayFolder: Estoque
		lineageTag: 40355d5c-9122-4d43-bd03-2da3f43b7fd6

	/// Consumo médio por dia no período.
	measure 'Consumo Médio Diário (g)' = DIVIDE ( [Consumo (g)], DISTINCTCOUNT ( fEstoque[Data] ) )
		formatString: #,0" g"
		displayFolder: Estoque
		lineageTag: e8d3e697-7d6a-400a-83bf-911ec863dfe1

	/// Quantos dias o estoque final dura no ritmo de consumo médio do período.
	measure 'Cobertura (dias)' = DIVIDE ( [Estoque Final (g)], [Consumo Médio Diário (g)] )
		formatString: #,0.0
		displayFolder: Estoque
		lineageTag: f4da9f07-cb16-4360-aab8-980e56e171e4

	/// Quantidade de ingredientes com estoque final abaixo do ponto de reposição.
	measure 'Ingredientes Abaixo do Mínimo' =
			VAR Lista =
			    ADDCOLUMNS (
			        VALUES ( dIngrediente[ID Ingrediente] ),
			        "@Final", [Estoque Final (g)],
			        "@Minimo", CALCULATE ( MAX ( dIngrediente[Estoque Mínimo (g)] ) )
			    )
			RETURN
			    COUNTROWS ( FILTER ( Lista, NOT ISBLANK ( [@Final] ) && [@Final] < [@Minimo] ) ) + 0
		formatString: #,0
		displayFolder: Estoque
		lineageTag: ee84875c-8f4a-41d0-b469-da08a640b8f1

	/// Custo estimado das coberturas/ingredientes consumidos no período (consumo em kg × custo por kg foodservice). Atenção: segue filtros de data e de ingrediente, mas NÃO de sabor/tamanho (o estoque não se relaciona com dPizzaTipo); o rateio por sabor é calculado no painel HTML.
	measure 'Custo de Ingredientes' = SUMX ( fEstoque, fEstoque[Consumo] / 1000 * RELATED ( dIngrediente[Custo por kg (US$)] ) )
		formatString: \$#,0.00
		displayFolder: Rentabilidade
		lineageTag: 057a29f1-fdb8-4346-8870-8ecff4e7ceeb

	/// Lucro bruto após custo direto de produção (Faturamento menos Custo de Produção Estimado). Use sem filtro de sabor/tamanho (ver Custo de Ingredientes).
	measure 'Margem Bruta' = [Faturamento] - [Custo de Produção Estimado]
		formatString: \$#,0.00
		displayFolder: Rentabilidade
		lineageTag: 02bb44c1-2d1a-41a4-9db0-4cefb90040e0

	/// Margem líquida estimada sobre o faturamento (considerando custo de ingredientes, massa, embalagem, operação, equipe, impostos e taxas). Use sem filtro de sabor/tamanho.
	measure 'Margem %' = DIVIDE ( [Margem Líquida Estimada], [Faturamento] )
		formatString: 0.0%
		displayFolder: Rentabilidade
		lineageTag: d129096e-9251-4268-9afc-8e27848f8afb

	/// [Componente] Série JSON de vendas e indicadores agregados para o painel HTML Dashboard Pizzaria.
	measure '_HTML Dados Vendas' =
			VAR _k =
			    "{f:" & FORMAT( COALESCE( [Faturamento], 0 ) * 100, "0" )
			        & ",p:" & FORMAT( COALESCE( [Pedidos], 0 ), "0" )
			        & ",q:" & FORMAT( COALESCE( [Pizzas Vendidas], 0 ), "0" )
			        & ",d:" & FORMAT( COALESCE( [Dias com Venda], 0 ), "0" )
			        & ",de:'" & FORMAT( MIN( dPedido[Data] ), "yyyy-MM-dd" ) & "'"
			        & ",ate:'" & FORMAT( MAX( dPedido[Data] ), "yyyy-MM-dd" ) & "'}"
			VAR _m =
			    CONCATENATEX(
			        VALUES( dCalendario[Mês] ),
			        "[" & dCalendario[Mês]
			            & "," & FORMAT( COALESCE( [Faturamento], 0 ) * 100, "0" )
			            & "," & FORMAT( COALESCE( [Pedidos], 0 ), "0" )
			            & "," & FORMAT( COALESCE( [Dias com Venda], 0 ), "0" )
			            & "," & FORMAT( COALESCE( [Pizzas Vendidas], 0 ), "0" )
			            & "," & FORMAT( COALESCE( [Custo Total Estimado], 0 ) * 100, "0" )
			            & "]",
			        ",", dCalendario[Mês], ASC
			    )
			VAR _h =
			    CONCATENATEX(
			        FILTER(
			            ADDCOLUMNS( CROSSJOIN( VALUES( dCalendario[Dia da Semana Nº] ), VALUES( dPedido[Hora Cheia] ) ), "@f", [Faturamento], "@p", [Pedidos] ),
			            NOT ISBLANK( [@f] )
			        ),
			        "[" & dCalendario[Dia da Semana Nº] & "," & dPedido[Hora Cheia] & "," & FORMAT( [@f] * 100, "0" ) & "," & FORMAT( [@p], "0" ) & "]",
			        ","
			    )
			VAR _c =
			    CONCATENATEX(
			        FILTER( ADDCOLUMNS( VALUES( dPizzaTipo[Categoria] ), "@f", [Faturamento], "@q", [Pizzas Vendidas] ), NOT ISBLANK( [@f] ) ),
			        "['" & SUBSTITUTE( SUBSTITUTE( dPizzaTipo[Categoria], "\", "\\" ), "'", "\'" ) & "'," & FORMAT( [@f] * 100, "0" ) & "," & FORMAT( [@q], "0" ) & "]",
			        ",", [@f], DESC
			    )
			VAR _z =
			    CONCATENATEX(
			        FILTER( ADDCOLUMNS( VALUES( dPizza[Tamanho] ), "@f", [Faturamento], "@q", [Pizzas Vendidas] ), NOT ISBLANK( [@f] ) ),
			        "['" & dPizza[Tamanho] & "'," & FORMAT( [@f] * 100, "0" ) & "," & FORMAT( [@q], "0" ) & "]",
			        ","
			    )
			VAR _sab = FILTER( ADDCOLUMNS( VALUES( dPizzaTipo[ID Sabor] ), "@f", [Faturamento] ), NOT ISBLANK( [@f] ) )
			VAR _s =
			    CONCATENATEX(
			        _sab,
			        "{id:'" & dPizzaTipo[ID Sabor]
			            & "',n:'" & SUBSTITUTE( SUBSTITUTE( CALCULATE( MAX( dPizzaTipo[Sabor] ) ), "\", "\\" ), "'", "\'" )
			            & "',c:'" & SUBSTITUTE( SUBSTITUTE( CALCULATE( MAX( dPizzaTipo[Categoria] ) ), "\", "\\" ), "'", "\'" )
			            & "',i:'" & SUBSTITUTE( SUBSTITUTE( CALCULATE( MAX( dPizzaTipo[Ingredientes] ) ), "\", "\\" ), "'", "\'" )
			            & "',f:" & FORMAT( [@f] * 100, "0" )
			            & ",p:" & FORMAT( COALESCE( [Pedidos], 0 ), "0" )
			            & ",q:" & FORMAT( COALESCE( [Pizzas Vendidas], 0 ), "0" )
			            & ",d:" & FORMAT( COALESCE( [Dias com Venda], 0 ), "0" )
			            & ",m:[" & CONCATENATEX(
			                    VALUES( dCalendario[Mês] ),
			                    "[" & dCalendario[Mês] & "," & FORMAT( COALESCE( [Faturamento], 0 ) * 100, "0" ) & "," & FORMAT( COALESCE( [Pedidos], 0 ), "0" ) & "," & FORMAT( COALESCE( [Dias com Venda], 0 ), "0" ) & "," & FORMAT( COALESCE( [Pizzas Vendidas], 0 ), "0" ) & "]",
			                    ",", dCalendario[Mês], ASC )
			            & "],h:[" & CONCATENATEX(
			                    FILTER(
			                        ADDCOLUMNS( CROSSJOIN( VALUES( dCalendario[Dia da Semana Nº] ), VALUES( dPedido[Hora Cheia] ) ), "@hf", [Faturamento], "@hp", [Pedidos] ),
			                        NOT ISBLANK( [@hf] )
			                    ),
			                    "[" & dCalendario[Dia da Semana Nº] & "," & dPedido[Hora Cheia] & "," & FORMAT( [@hf] * 100, "0" ) & "," & FORMAT( [@hp], "0" ) & "]",
			                    "," )
			            & "],z:[" & CONCATENATEX(
			                    FILTER( ADDCOLUMNS( VALUES( dPizza[Tamanho] ), "@zf", [Faturamento], "@zq", [Pizzas Vendidas] ), NOT ISBLANK( [@zf] ) ),
			                    "['" & dPizza[Tamanho] & "'," & FORMAT( [@zf] * 100, "0" ) & "," & FORMAT( [@zq], "0" ) & "]",
			                    "," )
			            & "]}",
			        ",", [@f], DESC
			    )
			RETURN
			    "var D={k:" & _k & ",m:[" & _m & "],h:[" & _h & "],c:[" & _c & "],z:[" & _z & "],s:[" & _s & "]};"
		isHidden
		displayFolder: Visuais HTML\Componentes
		lineageTag: 8a1f2c34-5678-4abc-9def-102030405001

	/// [Componente] Série JSON de estoque (fEstoque + dIngrediente) e catálogo completo (dPizzaTipo + dPizza) para cruzamento no painel e Pizz.IA.
	measure '_HTML Dados Estoque' =
			VAR _ud = MAX( fEstoque[Data] )
			VAR _gk = "{d:" & FORMAT( COALESCE( DISTINCTCOUNT( fEstoque[Data] ), 0 ), "0" ) & ",ate:'" & FORMAT( _ud, "yyyy-MM-dd" ) & "'}"
			VAR _ing =
			    CONCATENATEX(
			        FILTER(
			            ADDCOLUMNS( VALUES( dIngrediente[ID Ingrediente] ), "@fin", CALCULATE( SUM( fEstoque[Estoque Final] ), fEstoque[Data] = _ud ) ),
			            NOT ISBLANK( [@fin] )
			        ),
			        VAR _mn = CALCULATE( MAX( dIngrediente[Estoque Mínimo (g)] ) )
			        RETURN
			            "{n:'" & SUBSTITUTE( SUBSTITUTE( CALCULATE( MAX( dIngrediente[Ingrediente] ) ), "\", "\\" ), "'", "\'" )
			                & "',g:'" & SUBSTITUTE( SUBSTITUTE( CALCULATE( MAX( dIngrediente[Grupo] ) ), "\", "\\" ), "'", "\'" )
			                & "',pm:" & FORMAT( COALESCE( CALCULATE( MAX( dIngrediente[Porção M (g)] ) ), 0 ) * 100, "0" )
			                & ",cu:" & FORMAT( COALESCE( CALCULATE( MAX( dIngrediente[Custo por kg (US$)] ) ), 0 ) * 100, "0" )
			                & ",mn:" & FORMAT( COALESCE( _mn, 0 ), "0" )
			                & ",al:" & FORMAT( COALESCE( CALCULATE( MAX( dIngrediente[Estoque Alvo (g)] ) ), 0 ), "0" )
			                & ",fin:" & FORMAT( [@fin], "0" )
			                & ",co:" & FORMAT( COALESCE( CALCULATE( SUM( fEstoque[Consumo] ) ), 0 ), "0" )
			                & ",en:" & FORMAT( COALESCE( CALCULATE( SUM( fEstoque[Entrada] ) ), 0 ), "0" )
			                & ",ab:" & FORMAT( COALESCE( CALCULATE( COUNTROWS( fEstoque ), fEstoque[Estoque Final] < _mn ), 0 ), "0" )
			                & ",m:[" & CONCATENATEX(
			                        VALUES( dCalendario[Mês] ),
			                        "[" & dCalendario[Mês]
			                            & "," & FORMAT( COALESCE( CALCULATE( SUM( fEstoque[Consumo] ) ), 0 ), "0" )
			                            & "," & FORMAT( COALESCE( CALCULATE( VAR _u = MAX( fEstoque[Data] ) RETURN CALCULATE( SUM( fEstoque[Estoque Final] ), fEstoque[Data] = _u ) ), 0 ), "0" ) & "]",
			                        ",", dCalendario[Mês], ASC )
			                & "]}",
			        ","
			    )
			VAR _cad =
			    CONCATENATEX(
			        VALUES( dPizzaTipo[ID Sabor] ),
			        "{id:'" & dPizzaTipo[ID Sabor]
			            & "',n:'" & SUBSTITUTE( SUBSTITUTE( CALCULATE( MAX( dPizzaTipo[Sabor] ) ), "\", "\\" ), "'", "\'" )
			            & "',c:'" & SUBSTITUTE( SUBSTITUTE( CALCULATE( MAX( dPizzaTipo[Categoria] ) ), "\", "\\" ), "'", "\'" )
			            & "',i:'" & SUBSTITUTE( SUBSTITUTE( CALCULATE( MAX( dPizzaTipo[Ingredientes] ) ), "\", "\\" ), "'", "\'" )
			            & "',pr:[" & CONCATENATEX( CALCULATETABLE( dPizza ), "['" & dPizza[Tamanho] & "'," & FORMAT( dPizza[Preço] * 100, "0" ) & "]", "," )
			            & "]}",
			        ","
			    )
			RETURN
			    "D.g=[" & _ing & "];D.gk=" & _gk & ";D.cad=[" & _cad & "];"
		isHidden
		displayFolder: Visuais HTML\Componentes
		lineageTag: 8a1f2c34-5678-4abc-9def-102030405002

	/// [Componente] Folha de estilos CSS do painel HTML Dashboard Pizzaria.
	measure '_HTML CSS Painel' =
			"<style>
			:root{--pri:#ea580c;--pri-dk:#9a3412;--pri2:#fb923c;--pri3:#fff7ed;--txt:#0f172a;--sub:#475569;--bg:#f8fafc;--card:#ffffff;--borda:#e2e8f0;--borda-forte:#cbd5e1;--verde:#059669;--verde-bg:#ecfdf5;--verm:#dc2626;--verm-bg:#fef2f2;--up:#1d4ed8;--up-bg:#eff6ff;--dn:#b91c1c;--dn-bg:#fef2f2;--amb:#b45309;--amb-bg:#fffbeb}
			body.dark{--pri:#f97316;--pri-dk:#ea580c;--pri2:#fb923c;--pri3:rgba(249,115,22,0.16);--txt:#f4f4f6;--sub:#b0bac5;--bg:#121318;--card:#1a1c23;--borda:rgba(255,255,255,0.14);--borda-forte:rgba(255,255,255,0.24);--verde:#2bfdbe;--verde-bg:rgba(43,253,190,0.14);--verm:#fb7185;--verm-bg:rgba(251,113,133,0.16);--up:#2bfdbe;--up-bg:rgba(43,253,190,0.14);--dn:#fb7185;--dn-bg:rgba(251,113,133,0.16);--amb:#fdba74;--amb-bg:rgba(249,115,22,0.18)}
			body.dark .topo{background:#1a1c23;border:1px solid var(--borda);box-shadow:none}
			body.dark .bt{background:#232630;color:#f4f4f6;border-color:var(--borda)}
			body.dark .bt:hover{border-color:#f97316;color:#fb923c}
			body.dark .bt.ia{color:#fff}
			body.dark .chip.sel{background:var(--pri3);border-color:var(--pri);color:#fdba74}
			body.dark .kpi:first-child{background:#ededed;color:#0a0a0a;border-top-color:#f97316}
			body.dark .kpi:first-child .t{color:#425d6b}
			body.dark .kpi:first-child .v{color:#0a0a0a}
			body.dark .kpi:first-child .s{color:#4b5563}
			body.dark .kpi:first-child .vr{background:rgba(10,10,10,0.06)}
			body.dark .kpi:first-child .vr.up{color:#059669}
			body.dark .kpi:first-child .vr.dn{color:#dc2626}
			body.dark .bars .cw{background:rgba(255,255,255,0.04)}
			body.dark .bars .col{background:#4b5262}
			body.dark .bars .b.min .col{background:#343844}
			body.dark .bars .b.min .tg{color:#94a3b8}
			body.dark .bars .b.max .col{background:linear-gradient(180deg,#f97316 0%,#ea580c 100%)}
			body.dark #busca{background:#232630;color:#f4f4f6}
			body.dark #busca::placeholder{color:#94a3b8}
			body.dark th{background:#232630;color:#cbd5e1}
			body.dark td small{background:#232630;border-color:var(--borda);color:#cbd5e1}
			body.dark tbody tr:hover{background:#2a2e3b}
			body.dark tbody tr.on{background:rgba(249,115,22,0.18)}
			body.dark .abc.A{background:#f97316;color:#0a0a0a}
			body.dark .abc.B{background:#232630;color:#f4f4f6}
			body.dark .abc.C{background:transparent;color:#94a3b8;border-color:var(--borda)}
			body.dark .seg button{background:#232630;color:#cbd5e1}
			body.dark .seg button.on{background:#f97316;color:#0a0a0a}
			body.dark .citem,body.dark .est-row{background:#232630}
			body.dark .citem:hover,body.dark .est-row:hover{background:#2a2e3b}
			body.dark .citem.on{background:rgba(249,115,22,0.16)}
			body.dark .citem .tr,body.dark .est-tr{background:rgba(255,255,255,0.10)}
			body.dark .mgp.md{background:#2c303c;color:#f4f4f6}
			body.dark .alerta{background:#232630;border-color:rgba(249,115,22,0.45);color:#fdba74}
			body.dark #calor .cel{border-color:rgba(255,255,255,0.06)}
			body.dark #calor .cel.pico{box-shadow:inset 0 0 0 2px #ffffff}
			body.dark #modal .box,body.dark #iaP{background:#181a20;color:#f4f4f6;border-color:var(--borda-forte)}
			body.dark .iab,body.dark .iaf{background:#121318;color:#f4f4f6;border-color:var(--borda)}
			body.dark .iaop,body.dark .iamsg.a,body.dark .iasug button{background:#232630;color:#f4f4f6;border-color:rgba(255,255,255,0.16)}
			body.dark .iaop .t{color:#ffffff}
			body.dark .iaop .d,body.dark .iaintro{color:#cbd5e1}
			body.dark .iaop:hover,body.dark .iasug button:hover{background:#2a2e3b;border-color:#f97316;color:#ffffff}
			body.dark .iamd{color:#e2e8f0}
			body.dark .iamd h3{color:#fdba74}
			body.dark .iaf textarea,body.dark #modal textarea{background:#0f1116;color:#f4f4f6;border-color:var(--borda)}
			body.dark .iaesc{background:rgba(249,115,22,0.18);color:#fdba74}
			.bt.tema{display:inline-flex;align-items:center;gap:5px}
			*{box-sizing:border-box;margin:0;padding:0;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;text-rendering:geometricPrecision}
			html,body{height:100%;overflow:hidden;font-family:'Segoe UI',system-ui,-apple-system,Arial,sans-serif;color:var(--txt);background:var(--bg);font-size:13.5px;font-variant-numeric:tabular-nums}
			#app{height:100vh;padding:12px 14px;display:grid;gap:12px;grid-template-columns:repeat(12,minmax(0,1fr));grid-template-rows:auto auto minmax(0,1fr) minmax(0,1.22fr)}
			.cab{grid-column:span 12;display:flex;flex-direction:column;gap:10px}
			.card{background:var(--card);border:1px solid var(--borda);border-radius:12px;padding:12px 15px;min-width:0;box-shadow:0 1px 6px rgba(15,23,42,.04)}
			.topo{display:flex;flex-wrap:wrap;gap:10px;align-items:center;justify-content:space-between;background:linear-gradient(135deg,#0f172a 0%,#1e293b 100%);color:#fff;padding:10px 16px;border-radius:12px;box-shadow:0 3px 12px rgba(15,23,42,.12)}
			.topo h1{font-size:19px;font-weight:800;letter-spacing:-.2px;color:#fff}
			.topo .sub{font-size:12.5px;color:#cbd5e1;margin-top:2px;font-weight:500}
			.acoes{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
			.chip,.bt{border:1px solid var(--borda-forte);background:#fff;border-radius:999px;padding:5px 12px;font:inherit;font-size:12.5px;font-weight:600;cursor:pointer;color:var(--txt);white-space:nowrap;transition:all .15s}
			.chip.sel{background:#fff7ed;border-color:#fdba74;color:#9a3412;font-weight:700;max-width:300px;overflow:hidden;text-overflow:ellipsis}
			.bt:hover{border-color:var(--pri);color:var(--pri)}
			.bt.ia{display:inline-flex;align-items:center;gap:6px;background:linear-gradient(135deg,#4f46e5 0%,#7c3aed 52%,#ea580c 100%);border:0;color:#fff;font-weight:700;padding:6px 14px;box-shadow:0 2px 10px rgba(79,70,229,.35);letter-spacing:.1px}
			.bt.ia:hover{filter:brightness(1.08);transform:translateY(-1px);color:#fff}
			.bt:disabled{opacity:.55;cursor:default}
			.kpis{grid-column:span 12;display:grid;gap:12px;grid-template-columns:repeat(6,minmax(0,1fr))}
			.kpi{border-top:3.5px solid var(--pri);padding:9px 12px}
			.kpi:nth-child(2){border-top-color:#0284c7}
			.kpi:nth-child(3){border-top-color:#059669}
			.kpi:nth-child(4){border-top-color:#7c3aed}
			.kpi:nth-child(5){border-top-color:#d97706}
			.kpi:nth-child(6){border-top-color:#0f766e}
			.kpi .t{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.4px;color:var(--sub)}
			.kpi .v{font-size:22px;font-weight:800;color:var(--txt);margin-top:4px;line-height:1.12;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
			.kpi .s{font-size:11.5px;font-weight:500;color:var(--sub);margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
			.kpi .r{display:flex;align-items:center;gap:6px;margin-top:5px;min-height:22px}
			.kpi .sp{flex-shrink:0}
			.vr{font-size:10.5px;font-weight:700;white-space:nowrap;color:var(--sub);height:16px;padding:0 5px;border-radius:999px;display:inline-flex;align-items:center}
			.vr.up,.bars .vr.up{color:var(--up);background:var(--up-bg)}
			.vr.dn,.bars .vr.dn{color:var(--dn);background:var(--dn-bg)}
			.mes,.calor,.tab,.cat,.tam{display:flex;flex-direction:column;min-height:0;overflow:hidden}
			.mes{grid-column:span 7}
			.calor{grid-column:span 5}
			.tab{grid-column:span 6}
			.cat{grid-column:span 3}
			.tam{grid-column:span 3}
			h2{font-size:14.5px;font-weight:800;color:var(--txt);margin-bottom:10px;display:flex;gap:8px;align-items:center;justify-content:space-between;flex-wrap:wrap;flex-shrink:0}
			h2 small{font-weight:600;font-size:12px;color:var(--sub)}
			.bars{display:flex;align-items:stretch;gap:6px;flex:1;min-height:0}
			.tam .bars{flex:1;min-height:0}
			.bars .b{flex:1;display:flex;flex-direction:column;align-items:center;min-width:0;cursor:default}
			.bars .lv{font-size:10.8px;font-weight:800;color:var(--txt);white-space:nowrap;letter-spacing:-.2px}
			.bars .vr{font-size:10px;font-weight:700;white-space:nowrap;color:var(--sub);height:16px;padding:0 4px;border-radius:999px;margin-top:1px;display:inline-flex;align-items:center}
			.bars .cw{flex:1;width:100%;display:flex;align-items:flex-end;margin:4px 0;background:#f8fafc;border-radius:6px;padding:0 1px;min-height:0}
			.bars .col{width:100%;height:0;background:#cbd5e1;border-radius:6px 6px 2px 2px;transition:height .5s ease-out}
			.bars .b.min .col{background:#94a3b8}
			.bars .b:hover .col{background:#fb923c}
			.bars .b.max .col{background:linear-gradient(180deg,#ea580c 0%,#9a3412 100%);box-shadow:0 3px 10px rgba(154,52,18,.32)}
			.bars .lx{font-size:12px;font-weight:700;color:var(--sub)}
			.bars .ls{font-size:10.5px;font-weight:600;color:var(--sub);white-space:nowrap}
			.bars .tg{font-size:10px;font-weight:800;height:13px;line-height:13px;color:var(--pri-dk);white-space:nowrap}
			.bars .b.min .tg{color:#475569}
			#calor{display:grid;gap:3px;flex:1;min-height:0;grid-template-rows:auto repeat(7,minmax(0,1fr))}
			#calor .hc{min-height:0;border-radius:5px;min-width:0}
			#calor .hd{font-size:11px;font-weight:700;color:var(--sub);text-align:center;padding-bottom:2px}
			#calor .dl{font-size:11.5px;font-weight:700;color:var(--sub);display:flex;align-items:center}
			#calor .cel{cursor:default;border:1px solid rgba(15,23,42,.04)}
			#calor .cel:hover{outline:2px solid var(--txt);z-index:2}
			#calor .cel.pico{box-shadow:inset 0 0 0 2px #431407}
			.leg{display:flex;align-items:center;gap:6px;margin-top:8px;font-size:11.5px;font-weight:600;color:var(--sub);flex-shrink:0;flex-wrap:wrap}
			.leg i{display:inline-block;width:90px;height:8px;border-radius:4px;background:linear-gradient(90deg,rgba(234,88,12,.1),rgba(234,88,12,1))}
			.alerta{font-size:11.5px;font-weight:700;color:#7c2d12;background:#fff7ed;border:1px solid #fed7aa;border-radius:8px;padding:5px 8px;margin-top:6px;flex-shrink:0;line-height:1.35}
			.tb{display:flex;gap:8px;align-items:center;font-weight:400}
			.seg{display:inline-flex;border:1px solid var(--borda-forte);border-radius:999px;overflow:hidden;flex-shrink:0}
			.seg button{border:0;background:#fff;font:inherit;font-size:11.5px;font-weight:700;padding:4px 9px;cursor:pointer;color:var(--sub);display:inline-flex;align-items:center;gap:4px}
			.seg button.on{background:#0f172a;color:#fff}
			.bdg-al{background:#dc2626;color:#fff;font-size:10px;font-weight:800;border-radius:999px;padding:0 5px;line-height:15px}
			#busca{font:inherit;font-size:12px;font-weight:500;border:1px solid var(--borda-forte);border-radius:999px;padding:4px 10px;width:150px;outline:none;color:var(--txt);background:#f8fafc}
			#busca:focus{border-color:var(--pri);background:#fff;box-shadow:0 0 0 3px rgba(234,88,12,.12)}
			.tw{flex:1;min-height:0;overflow:auto;border-radius:10px;border:1px solid var(--borda)}
			table{width:100%;border-collapse:collapse;font-size:12.5px}
			th{position:sticky;top:0;background:#f1f5f9;font-size:10.8px;font-weight:800;text-transform:uppercase;letter-spacing:.25px;color:#334155;text-align:right;padding:7px 6px;cursor:pointer;user-select:none;white-space:nowrap;border-bottom:2px solid var(--borda-forte);z-index:2}
			th:first-child,th:nth-child(2){text-align:left}
			td{padding:6px 6px;border-top:1px solid var(--borda);text-align:right;white-space:nowrap;font-weight:600;color:var(--txt)}
			td:nth-child(2){text-align:left;white-space:normal;font-weight:700}
			td:first-child{text-align:left;color:var(--sub);width:24px;font-weight:700}
			th:last-child,td:last-child{padding-right:8px;text-align:center}
			td small{display:inline-block;color:#334155;background:#f1f5f9;border:1px solid #e2e8f0;padding:1px 6px;border-radius:999px;font-size:10.5px;font-weight:700;margin-left:6px;vertical-align:middle}
			tbody tr{cursor:pointer;transition:background .1s}
			tbody tr:hover{background:#fff7ed}
			tbody tr.on{background:#ffedd5;box-shadow:inset 4px 0 0 var(--pri)}
			.barra{display:inline-block;height:7px;border-radius:4px;background:#94a3b8;vertical-align:middle;margin-left:6px}
			.abc{display:inline-block;min-width:22px;text-align:center;border-radius:6px;padding:1px 6px;font-size:11px;font-weight:800}
			.abc.A{background:#0f172a;color:#fff}
			.abc.B{background:#e2e8f0;color:#0f172a}
			.abc.C{background:#fff;color:#b91c1c;border:1px solid #fca5a5}
			.mgp{display:inline-block;border-radius:6px;padding:1px 6px;font-size:11.5px;font-weight:700}
			.mgp.hi{background:var(--verde-bg);color:var(--verde)}
			.mgp.md{background:#f1f5f9;color:var(--txt)}
			.mgp.lo{background:var(--verm-bg);color:var(--verm)}
			.rod{font-size:11.5px;font-weight:600;color:var(--sub);margin-top:6px;flex-shrink:0}
			#cat{flex:1;min-height:0;display:flex;flex-direction:column;justify-content:space-between;gap:7px;overflow:auto;padding-right:2px}
			.citem{border:1px solid var(--borda);border-radius:10px;padding:8px 10px;background:#fff;cursor:pointer;transition:all .15s;display:flex;flex-direction:column;gap:5px}
			.citem:hover{border-color:#fdba74;background:#fffaf5}
			.citem.on{border-color:var(--pri);background:#fff7ed;box-shadow:inset 3px 0 0 var(--pri)}
			.citem .ctop{display:flex;justify-content:space-between;align-items:baseline;gap:6px}
			.citem .cn{font-size:13px;font-weight:800;color:var(--txt)}
			.citem .cf{font-size:12.5px;font-weight:800;color:var(--txt)}
			.citem .cmid{display:flex;justify-content:space-between;align-items:center;font-size:11px;font-weight:600;color:var(--sub);gap:6px}
			.citem .tr{height:8px;border-radius:999px;background:#f1f5f9;overflow:hidden}
			.citem .fi{height:100%;border-radius:999px;background:linear-gradient(90deg,#fb923c,#ea580c);transition:width .4s ease-out}
			.citem.on .fi{background:linear-gradient(90deg,#ea580c,#9a3412)}
			.est-row{border:1px solid var(--borda);border-radius:9px;padding:6px 9px;background:#fff;display:flex;flex-direction:column;gap:4px;cursor:default}
			.est-row:hover{border-color:var(--borda-forte);background:#f8fafc}
			.est-top{display:flex;justify-content:space-between;align-items:center;gap:6px;font-size:12px}
			.est-top b{font-weight:700;color:var(--txt);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
			.est-meta{display:flex;justify-content:space-between;font-size:11px;color:var(--sub);font-weight:600}
			.est-bdg{font-size:10px;font-weight:800;padding:1px 6px;border-radius:999px;flex-shrink:0}
			.est-bdg.crit{background:var(--verm-bg);color:var(--verm)}
			.est-bdg.att{background:var(--amb-bg);color:var(--amb)}
			.est-bdg.ok{background:var(--verde-bg);color:var(--verde)}
			.est-tr{height:5px;border-radius:999px;background:#f1f5f9;overflow:hidden}
			.est-fi{height:100%;border-radius:999px}
			#tip{position:fixed;pointer-events:none;opacity:0;background:#0f172a;color:#fff;padding:9px 11px;border-radius:9px;font-size:12.5px;line-height:1.5;z-index:30;transition:opacity .12s;max-width:300px;box-shadow:0 8px 24px rgba(15,23,42,.35);border:1px solid #334155}
			#tip b{color:#fb923c;font-size:13px}
			#modal{display:none;position:fixed;inset:0;background:rgba(15,23,42,.55);z-index:40;align-items:center;justify-content:center}
			#modal .box{background:#fff;border-radius:14px;padding:16px;width:min(560px,92vw);box-shadow:0 12px 32px rgba(15,23,42,.25)}
			#modal textarea{width:100%;height:180px;font:12px Consolas,monospace;margin:10px 0;border:1px solid var(--borda-forte);border-radius:8px;padding:8px}
			#modal .msg{font-size:12px;font-weight:600;color:var(--sub);min-height:16px}
			#iaP{position:fixed;top:0;right:0;bottom:0;width:min(440px,100vw);background:#fff;z-index:35;box-shadow:-8px 0 30px rgba(15,23,42,.25);display:none;flex-direction:column;border-left:1px solid var(--borda)}
			#iaP.on{display:flex}
			.iah{display:flex;align-items:center;gap:8px;padding:12px 14px;background:linear-gradient(135deg,#4f46e5,#7c3aed 55%,#ea580c);color:#fff;flex-shrink:0}
			.iah b{flex:1;font-size:14.5px;font-weight:800;display:flex;align-items:center;gap:6px}
			.iah button{background:rgba(255,255,255,.18);border:0;color:#fff;border-radius:999px;padding:4px 10px;font:inherit;font-size:12px;font-weight:700;cursor:pointer}
			.iah button:hover{background:rgba(255,255,255,.3)}
			.iaesc{font-size:11.5px;font-weight:700;color:#4f46e5;background:#eef2ff;border-radius:999px;padding:3px 10px;display:inline-block;margin-bottom:10px}
			.iab{flex:1;overflow:auto;padding:14px;background:#f8fafc}
			.iaop{display:block;width:100%;text-align:left;background:#fff;border:1px solid #e0e7ff;border-radius:12px;padding:14px;margin-bottom:10px;cursor:pointer;font:inherit;transition:all .15s}
			.iaop:hover{border-color:#4f46e5;box-shadow:0 4px 14px rgba(79,70,229,.15);transform:translateY(-1px)}
			.iaop .t{font-size:14px;font-weight:800;color:#0f172a}
			.iaop .d{font-size:12.5px;color:var(--sub);margin-top:4px;line-height:1.45}
			.iamd{font-size:13px;line-height:1.55;color:var(--txt)}
			.iamd h3{font-size:13.5px;font-weight:800;color:#4f46e5;margin:14px 0 4px}
			.iamd h3:first-child{margin-top:0}
			.iamd ul{margin:4px 0 6px 18px}
			.iamd li{margin:2px 0}
			.iamd p{margin:4px 0}
			.iamd b{font-weight:800}
			.iamsg{max-width:88%;padding:9px 12px;border-radius:12px;margin-bottom:8px;font-size:13px;line-height:1.5;overflow-wrap:break-word}
			.iamsg.u{margin-left:auto;background:var(--pri);color:#fff;border-bottom-right-radius:4px;white-space:pre-wrap}
			.iamsg.a{background:#fff;border:1px solid #e0e7ff;border-bottom-left-radius:4px}
			.iamsg.e{background:var(--verm-bg);color:var(--verm);border:1px solid #fecaca}
			.iaintro{font-size:13px;color:var(--sub);line-height:1.5;margin-bottom:8px}
			.iasug{display:flex;flex-wrap:wrap;gap:6px;margin:4px 0 10px}
			.iasug button{border:1px solid #e0e7ff;background:#fff;color:#4f46e5;border-radius:999px;padding:5px 10px;font:inherit;font-size:12px;font-weight:600;cursor:pointer;text-align:left}
			.iasug button:hover{border-color:#4f46e5;background:#eef2ff}
			.iaf{display:flex;gap:8px;padding:10px 12px;border-top:1px solid var(--borda);background:#fff;flex-shrink:0}
			.iaf textarea{flex:1;resize:none;height:42px;font:inherit;font-size:13px;border:1px solid var(--borda-forte);border-radius:10px;padding:8px 10px;outline:none;color:var(--txt)}
			.iaf textarea:focus{border-color:#4f46e5;box-shadow:0 0 0 3px rgba(79,70,229,.12)}
			.iaf button,.iabt{border:0;border-radius:10px;padding:0 14px;background:linear-gradient(135deg,#4f46e5,#7c3aed,#ea580c);color:#fff;font:inherit;font-weight:700;cursor:pointer}
			.iabt{padding:7px 14px;margin-top:12px;border-radius:999px;font-size:12.5px}
			.iaf button:disabled{opacity:.5;cursor:default}
			.iadig{display:inline-flex;gap:4px;vertical-align:middle;margin-right:6px}
			.iadig i{width:6px;height:6px;border-radius:50%;background:#6366f1;animation:iad 1s infinite}
			.iadig i:nth-child(2){animation-delay:.15s}
			.iadig i:nth-child(3){animation-delay:.3s}
			@keyframes iad{0%,80%,100%{opacity:.3}40%{opacity:1}}
			@media (max-width:1100px){html,body{overflow:auto}#app{height:auto;grid-template-rows:auto}.mes,.calor,.tab{grid-column:span 12}.cat,.tam{grid-column:span 6}.bars{min-height:190px}.tw{max-height:300px}}
			@media (max-width:700px){.cat,.tam{grid-column:span 12}.kpis{grid-template-columns:repeat(2,minmax(0,1fr))}#busca{width:150px}}
			</style>"
		isHidden
		displayFolder: Visuais HTML\Componentes
		lineageTag: 8a1f2c34-5678-4abc-9def-102030405003

	/// [Componente] JavaScript interativo do painel HTML Dashboard Pizzaria (indicadores, gráficos, Categorias & Estoque, estrutura de custos e Pizz.IA).
	measure '_HTML JS Painel' =
			"var api = window.pbi || { estado: {}, filtrar: function () {}, limpar: function () {}, iaConfigurada: function () { return false; } };
			var st = api.estado;
			st.met = 'f';
			if (!st.tema) st.tema = 'light';
			if (!st.ia) st.ia = { modo: null, chat: [], analise: null, esperando: false, rascunho: '' };
			if (!st.ord) st.ord = { c: 'f', d: -1 };
			if (!st.catView) st.catView = 'cat';
			if (st.catFil === undefined) st.catFil = null;
			if (st.busca === undefined) st.busca = '';
			var MES = ['jan', 'fev', 'mar', 'abr', 'mai', 'jun', 'jul', 'ago', 'set', 'out', 'nov', 'dez'];
			var MESN = ['Janeiro', 'Fevereiro', 'Março', 'Abril', 'Maio', 'Junho', 'Julho', 'Agosto', 'Setembro', 'Outubro', 'Novembro', 'Dezembro'];
			var DIA = ['Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sáb', 'Dom'];
			var DIAN = ['Segunda', 'Terça', 'Quarta', 'Quinta', 'Sexta', 'Sábado', 'Domingo'];
			var TAM = ['S', 'M', 'L', 'XL', 'XXL'];
			var TAMN = { S: 'Pequena', M: 'Média', L: 'Grande', XL: 'Extragrande', XXL: 'Gigante' };
			var FAT = { S: 0.7, M: 1, L: 1.35, XL: 1.7, XXL: 2.1 };
			var TAML = { S: 'P', M: 'M', L: 'G', XL: 'GG', XXL: 'XGG' };
			var CATN = { Classic: 'Clássica', Supreme: 'Suprema', Chicken: 'Frango', Veggie: 'Vegetariana' };
