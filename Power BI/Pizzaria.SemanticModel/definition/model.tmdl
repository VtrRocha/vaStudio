model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode","MCP-PBIModeling"]

annotation PBI_QueryOrder = ["PastaDados","dPizzaTipo","dPizza","dPedido","fItemPedido","dIngrediente","fEstoque"]

ref table dPizzaTipo
ref table dPizza
ref table dPedido
ref table fItemPedido
ref table Medidas
ref table dCalendario
ref table dIngrediente
ref table fEstoque

ref cultureInfo pt-BR

